<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiscImageStudio.Linux.Views.MessageWindow"
        Width="460" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Title="Disc Image Studio">
  <StackPanel Margin="24,22,24,20" Spacing="12">
    <TextBlock Name="TitleText" Classes="h2" TextWrapping="Wrap" />
    <TextBlock Name="MessageText" TextWrapping="Wrap" Classes="muted" LineHeight="20" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Name="CancelButton" IsCancel="True" />
      <Button Name="SecondaryButton" />
      <Button Name="PrimaryButton" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
