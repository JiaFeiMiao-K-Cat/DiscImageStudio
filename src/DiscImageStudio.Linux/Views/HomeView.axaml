<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiscImageStudio.Linux.ViewModels"
             xmlns:c="using:DiscImageStudio.Linux.Controls"
             x:Class="DiscImageStudio.Linux.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <ScrollViewer>
    <StackPanel Margin="56,44,56,40" MaxWidth="1180" Spacing="0">
      <TextBlock Classes="h1" FontSize="30" Text="Disc Image Studio" />
      <TextBlock Classes="muted" FontSize="14" Margin="0,6,0,24" TextWrapping="Wrap"
                 Text="Design, generate and burn pictures that appear on the recording side of CD, DVD and Blu-ray discs." />

      <Border Classes="card" Padding="20,16">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <c:LucideIcon Data="{x:Static c:Icons.FolderOpen}" Width="22" Height="22" Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="Projects" Classes="h3" />
            <TextBlock Classes="caption" Text="Projects are .discproj files. They open in the Windows app too, so designs can move between systems." />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenProjectCommand}" ToolTip.Tip="Ctrl+O">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LucideIcon Data="{x:Static c:Icons.FolderOpen}" Width="16" Height="16" />
                <TextBlock Text="Open project…" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NewProjectCommand}" ToolTip.Tip="Ctrl+N">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LucideIcon Data="{x:Static c:Icons.Plus}" Width="16" Height="16" />
                <TextBlock Text="New project" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Classes="h3" Text="Start from a template" Margin="0,34,0,12" />
      <ItemsControl ItemsSource="{Binding Templates}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TemplateItem">
            <Button Classes="tile" Margin="0,0,8,8"
                    Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).NewFromTemplateCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Preset.Description, FallbackValue='Start with default parameters'}">
              <StackPanel Spacing="8" HorizontalAlignment="Center">
                <c:LucideIcon Data="{Binding Icon}" Width="34" Height="34" StrokeThickness="1.6" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                <TextBlock Text="{Binding Subtitle}" Classes="caption" TextAlignment="Center" HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid ColumnDefinitions="*,Auto" Margin="0,26,0,12">
        <TextBlock Classes="h3" Text="Recent projects" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="ghost" Content="Clear list" Command="{Binding ClearRecentCommand}" IsVisible="{Binding HasRecent}" Foreground="{DynamicResource TextSecondaryBrush}" />
      </Grid>
      <TextBlock Classes="caption" IsVisible="{Binding !HasRecent}" Text="Projects you open or create appear here." />
      <ItemsControl ItemsSource="{Binding Recent}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentProjectItem">
            <Button Classes="recent" Width="370" Height="104" Margin="0,0,14,14" ClipToBounds="True"
                    Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding Path}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="18,0,8,0" VerticalAlignment="Center" Spacing="8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip"><TextBlock Text="{Binding FamilyLabel}" /></Border>
                    <c:LucideIcon Data="{x:Static c:Icons.Folder}" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Folder}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" TextWrapping="NoWrap" />
                  </StackPanel>
                  <TextBlock Text="File not found" Foreground="{DynamicResource WarningBrush}" FontSize="12" IsVisible="{Binding !Exists}" />
                </StackPanel>
                <!-- Disc-shaped thumbnail peeking out of the card edge -->
                <Panel Grid.Column="1" Width="92" Height="92" Margin="0,0,-18,0" VerticalAlignment="Center">
                  <Ellipse Fill="{DynamicResource Surface3Brush}" />
                  <Ellipse IsVisible="{Binding HasThumbnail}">
                    <Ellipse.Fill>
                      <ImageBrush Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Width="16" Height="16" Fill="{DynamicResource Surface1Brush}" />
                  <Ellipse Stroke="{DynamicResource DividerBrush}" StrokeThickness="1" />
                </Panel>
                <Button Grid.Column="0" Classes="icon" Padding="4" Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).RemoveRecentCommand}" CommandParameter="{Binding}"
                        ToolTip.Tip="Remove from the list">
                  <c:LucideIcon Data="{x:Static c:Icons.X}" Width="13" Height="13" />
                </Button>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="warning" Margin="0,22,0,0">
        <Grid ColumnDefinitions="Auto,*">
          <c:LucideIcon Data="{x:Static c:Icons.TriangleAlert}" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12"
                     Text="Burning drawn data is experimental and the result depends on the disc, the recorder and its firmware. Use blank, expendable media only." />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
