<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiscImageStudio.Linux.ViewModels"
             xmlns:c="using:DiscImageStudio.Linux.Controls"
             x:Class="DiscImageStudio.Linux.Views.PreviewView"
             x:DataType="vm:PreviewViewModel">
  <Grid Margin="28,10,28,20" ColumnDefinitions="*,340" ColumnSpacing="18">
    <Border CornerRadius="12" ClipToBounds="True" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
      <Panel>
        <c:PreviewSurface Source="{Binding Slot.Image}" Info="{Binding Slot.Info}" Margin="12" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="420" IsVisible="{Binding !Slot.HasImage}">
          <c:LucideIcon Data="{x:Static c:Icons.ScanEye}" Width="40" Height="40" StrokeThickness="1.4" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Slot.Status}" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Classes="inset" Padding="10,5" IsVisible="{Binding Slot.IsRendering}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <c:LucideIcon Data="{x:Static c:Icons.LoaderCircle}" Width="14" Height="14" Classes.spin="{Binding Slot.IsRendering}" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Text="Rendering…" FontSize="12" />
          </StackPanel>
        </Border>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Classes="caption" Opacity="0.8"
                   Text="Scroll to zoom · drag to pan · double-click to fit" />
      </Panel>
    </Border>

    <ScrollViewer Grid.Column="1" Padding="0,0,6,0">
      <StackPanel Spacing="14">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Border Classes="segments">
              <UniformGrid Columns="2">
                <RadioButton Classes="segment" IsChecked="{Binding IsProjection}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LucideIcon Data="{x:Static c:Icons.Palette}" Width="14" Height="14" />
                    <TextBlock Text="Design" />
                  </StackPanel>
                </RadioButton>
                <RadioButton Classes="segment" IsChecked="{Binding IsReadback}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LucideIcon Data="{x:Static c:Icons.HardDrive}" Width="14" Height="14" />
                    <TextBlock Text="Read-back" />
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </Border>
            <TextBlock Classes="caption" Text="{Binding ModeDescription}" />

            <StackPanel Spacing="10" IsVisible="{Binding IsProjection}">
              <ToggleSwitch IsChecked="{Binding UseMeasuredRadii}" OnContent="Project onto measured radii" OffContent="Project onto measured radii" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding UseMeasuredRadii}">
                <StackPanel>
                  <TextBlock Classes="label" Text="Measured inner (mm)" />
                  <TextBox Text="{Binding MeasuredInnerText}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Classes="label" Text="Measured outer (mm)" />
                  <TextBox Text="{Binding MeasuredOuterText}" />
                </StackPanel>
              </Grid>
              <Button Content="Use the project radii" Command="{Binding ResetMeasuredCommand}" IsVisible="{Binding UseMeasuredRadii}" />
            </StackPanel>

            <StackPanel Spacing="8" IsVisible="{Binding IsReadback}">
              <TextBlock Classes="label" Text="Generated file" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding ReadbackFile}" />
                <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseReadbackCommand}" />
              </Grid>
              <TextBlock Classes="caption" Text="{Binding ReadbackHint}" />
            </StackPanel>

            <StackPanel>
              <TextBlock Classes="label" Text="Resolution (px)" />
              <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" />
            </StackPanel>
            <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RenderCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:LucideIcon Data="{x:Static c:Icons.RefreshCw}" Width="15" Height="15" />
                <TextBlock Text="Render" />
              </StackPanel>
            </Button>
            <TextBlock Classes="caption" Foreground="{DynamicResource DangerBrush}" Text="{Binding Slot.Status}" IsVisible="{Binding Slot.HasError}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Classes="h3" Text="Reading the preview" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="14" Height="14" CornerRadius="3" Background="Black" BorderBrush="#55888888" BorderThickness="1" />
              <TextBlock Classes="caption" Text="Dark level (pits / 3T runs)" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="14" Height="14" CornerRadius="3" Background="White" BorderBrush="#55888888" BorderThickness="1" />
              <TextBlock Classes="caption" Text="Light level (lands / 6T runs)" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="14" Height="14" CornerRadius="3" Background="#808080" />
              <TextBlock Classes="caption" Text="Not picture data" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="14" Height="14" CornerRadius="3" Background="#B0FACC15" />
              <TextBlock Classes="caption" Text="Filesystem area" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="caption" Margin="0,4,0,0"
                       Text="These are nominal byte patterns, not an optical simulation: the visible contrast on a real disc depends on the dye, the recorder and its write strategy." />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
