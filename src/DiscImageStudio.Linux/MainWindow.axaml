<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DiscImageStudio.Linux.ViewModels"
        xmlns:views="using:DiscImageStudio.Linux.Views"
        xmlns:c="using:DiscImageStudio.Linux.Controls"
        mc:Ignorable="d" d:DesignWidth="1360" d:DesignHeight="860"
        x:Class="DiscImageStudio.Linux.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/DiscImageStudio-256.png"
        Width="1400" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewProjectCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
    <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseProjectCommand}" />
    <KeyBinding Gesture="Ctrl+I" Command="{Binding Design.ImportImagesCommand}" />
    <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleLogCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Home}" />
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Design}" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Preview}" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Export}" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Burn}" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Calibrate}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="236,*">
    <!-- Sidebar -->
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="6,0,0,22">
          <Image Source="/Assets/DiscImageStudio-256.png" Width="30" Height="30" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Disc Image Studio" FontWeight="SemiBold" FontSize="14" />
            <TextBlock Text="for Linux" Classes="caption" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
          <Button Classes="nav" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Settings (Ctrl+,)">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Settings}" />
              <TextBlock Text="Settings" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding OpenAboutCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Info}" />
              <TextBlock Text="About" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Spacing="2">
          <!-- Open project card -->
          <Border Classes="sidecard" Margin="0,0,0,14" IsVisible="{Binding HasProject}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding Project.DisplayTitle, FallbackValue=''}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Project.FilePath, FallbackValue=''}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="chip"><TextBlock Text="{Binding Project.FamilyLabel, FallbackValue=''}" /></Border>
                <TextBlock Text="{Binding Project.LayerCountText, FallbackValue=''}" Classes="caption" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="-6,2,0,-4">
                <Button Classes="icon" Command="{Binding SaveProjectCommand}" ToolTip.Tip="Save project (Ctrl+S)">
                  <c:LucideIcon Data="{x:Static c:Icons.Save}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" Command="{Binding EditProjectCommand}" ToolTip.Tip="Project settings: name and disc geometry">
                  <c:LucideIcon Data="{x:Static c:Icons.SlidersHorizontal}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon" Command="{Binding CloseProjectCommand}" ToolTip.Tip="Close project (Ctrl+W)">
                  <c:LucideIcon Data="{x:Static c:Icons.X}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Classes="nav" Classes.selected="{Binding IsHomePage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Home}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.House}" />
              <TextBlock Text="Home" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsDesignPage}" IsEnabled="{Binding HasProject}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Design}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Palette}" />
              <TextBlock Text="Design" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsPreviewPage}" IsEnabled="{Binding HasProject}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Preview}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Eye}" />
              <TextBlock Text="Preview" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsExportPage}" IsEnabled="{Binding HasProject}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Export}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Download}" />
              <TextBlock Text="Export" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsBurnPage}" IsEnabled="{Binding HasProject}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Burn}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Flame}" />
              <TextBlock Text="Burn" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Classes.selected="{Binding IsCalibratePage}" IsEnabled="{Binding HasProject}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Calibrate}"
                  ToolTip.Tip="Measure the disc geometry your drive really writes (Ctrl+5)">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <c:LucideIcon Data="{x:Static c:Icons.Crosshair}" />
              <TextBlock Text="Calibrate" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main area -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto">
      <!-- Page header for project pages -->
      <Grid Grid.Row="0" Margin="28,22,28,6" ColumnDefinitions="*,Auto" IsVisible="{Binding IsProjectPage}">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Classes="h1" Text="{Binding PageTitle}" />
            <Border Classes="chip" Margin="0,4,0,0"><TextBlock Text="{Binding Project.FamilyLabel, FallbackValue=''}" /></Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="step" Classes.selected="{Binding IsDesignPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Design}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="dot" Width="20" Height="20" CornerRadius="10"><TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Design" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="step" Classes.selected="{Binding IsPreviewPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Preview}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="dot" Width="20" Height="20" CornerRadius="10"><TextBlock Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Preview" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="step" Classes.selected="{Binding IsExportPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Export}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="dot" Width="20" Height="20" CornerRadius="10"><TextBlock Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Export" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="step" Classes.selected="{Binding IsBurnPage}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Burn}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Classes="dot" Width="20" Height="20" CornerRadius="10"><TextBlock Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Burn" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
          <Button Command="{Binding EditProjectCommand}" ToolTip.Tip="Name and disc geometry">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Data="{x:Static c:Icons.SlidersHorizontal}" Width="16" Height="16" />
              <TextBlock Text="Project settings" />
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveProjectCommand}" ToolTip.Tip="Ctrl+S">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:LucideIcon Data="{x:Static c:Icons.Save}" Width="16" Height="16" />
              <TextBlock Text="Save" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Command="{Binding GoNextCommand}" IsVisible="{Binding HasNextPage}" Content="{Binding NextPageText}" />
        </StackPanel>
      </Grid>

      <!-- Pages -->
      <Panel Grid.Row="1">
        <views:HomeView DataContext="{Binding Home}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsHomePage}" />
        <views:DesignView DataContext="{Binding Design}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsDesignPage}" />
        <views:PreviewView DataContext="{Binding Preview}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsPreviewPage}" />
        <views:ExportView DataContext="{Binding Export}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsExportPage}" />
        <views:BurnView DataContext="{Binding Burn}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsBurnPage}" />
        <views:CalibrateView DataContext="{Binding Calibration}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsCalibratePage}" />

        <!-- Notifications -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16" Width="380">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ToastViewModel">
              <Border Classes="toast">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Panel Margin="0,1,12,0" VerticalAlignment="Top">
                    <c:LucideIcon Data="{Binding Icon}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsSuccess}" />
                    <c:LucideIcon Data="{Binding Icon}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding IsError}" />
                    <c:LucideIcon Data="{Binding Icon}" Foreground="{DynamicResource WarningBrush}" IsVisible="{Binding IsWarning}" />
                    <c:LucideIcon Data="{Binding Icon}" Foreground="{DynamicResource PrimaryBrush}" IsVisible="{Binding IsInfo}" />
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="120" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="icon" Padding="3" Margin="8,-2,-6,0" VerticalAlignment="Top"
                          Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DismissToastCommand}" CommandParameter="{Binding}">
                    <c:LucideIcon Data="{x:Static c:Icons.X}" Width="14" Height="14" />
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Panel>

      <!-- Log -->
      <Border Grid.Row="2" IsVisible="{Binding IsLogOpen}" Height="230" Background="{DynamicResource LogBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="16,8,10,4">
            <TextBlock Text="Job log" Classes="h3" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button Classes="icon" Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy log"><c:LucideIcon Data="{x:Static c:Icons.Copy}" Width="15" Height="15" /></Button>
              <Button Classes="icon" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear log"><c:LucideIcon Data="{x:Static c:Icons.Trash2}" Width="15" Height="15" /></Button>
              <Button Classes="icon" Command="{Binding ToggleLogCommand}" ToolTip.Tip="Hide log (Ctrl+L)"><c:LucideIcon Data="{x:Static c:Icons.X}" Width="15" Height="15" /></Button>
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" Name="LogScroller" Padding="16,0,16,10">
            <SelectableTextBlock Classes="mono" Text="{Binding LogText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Status bar -->
      <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource SidebarBrush}" Padding="20,8">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
          <Panel Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
            <c:LucideIcon Data="{x:Static c:Icons.LoaderCircle}" Width="16" Height="16" Foreground="{DynamicResource PrimaryBrush}" IsVisible="{Binding IsBusy}" Classes.spin="{Binding IsBusy}" />
            <c:LucideIcon Data="{x:Static c:Icons.CircleCheck}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding JobSucceeded}" />
            <c:LucideIcon Data="{x:Static c:Icons.CircleX}" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding JobFailed}" />
          </Panel>
          <TextBlock Grid.Column="1" Text="{Binding JobTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
          <TextBlock Grid.Column="2" Text="{Binding JobStatus}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" Margin="12,0">
            <ProgressBar Width="220" Value="{Binding JobProgress}" IsIndeterminate="{Binding JobIndeterminate}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding JobElapsed}" Classes="muted mono" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="4" Content="Cancel" IsVisible="{Binding CanCancelJob}" Command="{Binding CancelJobCommand}" Padding="12,4" Margin="0,0,8,0" />
          <ToggleButton Grid.Column="5" IsChecked="{Binding IsLogOpen}" Padding="10,4" ToolTip.Tip="Show the job log (Ctrl+L)">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:LucideIcon Data="{x:Static c:Icons.Terminal}" Width="14" Height="14" />
              <TextBlock Text="Log" />
            </StackPanel>
          </ToggleButton>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
