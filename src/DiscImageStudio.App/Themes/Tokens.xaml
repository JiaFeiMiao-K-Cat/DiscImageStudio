<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Design tokens (single source of truth).
      Dark theme aligned with the reference design language: near-black background,
      layered surfaces, 12% white dividers, and the product brand blue.
    -->

    <Color x:Key="BackgroundColor">#121212</Color>
    <Color x:Key="Surface1Color">#18181B</Color>
    <Color x:Key="Surface2Color">#26262B</Color>
    <Color x:Key="Surface3Color">#2E2E33</Color>
    <Color x:Key="DividerColor">#1FFFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FAFAFA</Color>
    <Color x:Key="TextSecondaryColor">#A1A1AA</Color>
    <Color x:Key="TextMutedColor">#8C8C92</Color>
    <!-- Brand blue pair: 3385FF is the base fill on dark surfaces, 74C0FF the lighter
         emphasis used for hover states and accent text/icons on dark backgrounds. -->
    <Color x:Key="PrimaryColor">#3385FF</Color>
    <!-- Label on a filled Primary surface (segmented thumb): white in both themes. -->
    <Color x:Key="OnPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="PrimaryHoverColor">#74C0FF</Color>
    <Color x:Key="PrimaryPressedColor">#2569CC</Color>
    <Color x:Key="PrimarySoftColor">#1F3385FF</Color>
    <Color x:Key="DangerColor">#F31260</Color>
    <!-- Danger buttons keep their own hover/pressed ramp: a red action must not borrow the
         brand blue the way the shared filled-button triggers would otherwise give it. -->
    <Color x:Key="DangerHoverColor">#FF4D84</Color>
    <Color x:Key="DangerPressedColor">#C10A4A</Color>
    <Color x:Key="WarningColor">#F5A524</Color>
    <Color x:Key="SuccessColor">#17C964</Color>
    <Color x:Key="CloseHotColor">#C42B1C</Color>
    <Color x:Key="ScrollbarThumbColor">#3D3D45</Color>
    <Color x:Key="ScrollbarThumbHoverColor">#52525B</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CloseHotBrush" Color="{StaticResource CloseHotColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}" />

    <!-- Scroll edge fades: opaque background color blending to a transparent stop of the
         same hue; applied as template overlays because WPF OpacityMask breaks on scrolling
         ScrollContentPresenters (viewport blanks out on scroll). -->
    <Color x:Key="BackgroundFadeColor">#00121212</Color>
    <LinearGradientBrush x:Key="ScrollFadeTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundFadeColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollFadeBottomBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundFadeColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
    </LinearGradientBrush>

    <!-- Transparent overlays over the background -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#80000000" />
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#803385FF" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#14F5A524" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DF5A524" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E5C783" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FF31260" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4DF31260" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F17C964" />
    <!-- 90%-alpha variant of the close hot color; the plain CloseHotBrush is too heavy for
         a full-button hover fill at 32px. -->
    <SolidColorBrush x:Key="CloseHotSoftBrush" Color="#E6C42B1C" />

    <!-- The neutral hover surface for list rows and sidebar entries. It sits between the
         background and Surface1 so a hovered row reads on any surface without a border. -->
    <Color x:Key="SurfaceHoverColor">#1B1B1C</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <!-- Family badge chip painted over thumbnails (needs its own opacity to stay readable). -->
    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#CC121212" />

    <!-- Acknowledgement sheen swept across the project header: white on dark surfaces,
         black on light ones (the light palette overrides the three color tokens). -->
    <Color x:Key="ShineClearColor">#00FFFFFF</Color>
    <Color x:Key="ShineSoftColor">#26FFFFFF</Color>
    <Color x:Key="ShineCoreColor">#66FFFFFF</Color>

    <!-- Transparent end of the sleeve's path fade. A transparent stop keeps its RGB during
         gradient interpolation, so it cannot reuse the surface color directly. -->
    <Color x:Key="Surface1FadeColor">#0018181B</Color>

    <!-- Shape and metric tokens: radii, control heights and the shared page padding.
         Keeping them here is what stops every view from inventing its own 24/26/32.
         The metrics follow a tool-density scale (controls 28–34 px, cards 12 px arcs):
         a workspace application shows more working surface than chrome. -->
    <CornerRadius x:Key="RadiusField">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <!-- Inner card headers sit inside the card's 1px stroke, so their top arc is one less. -->
    <CornerRadius x:Key="RadiusCardHeader">11,11,0,0</CornerRadius>
    <!-- Mirror arc for the last row inside a card (footer strips, status rows). -->
    <CornerRadius x:Key="RadiusCardFooter">0,0,11,11</CornerRadius>
    <!-- Small chips, dots and inline thumbnails. -->
    <CornerRadius x:Key="RadiusChip">5</CornerRadius>
    <!-- Inner panels nested inside a card body. -->
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <sys:Double x:Key="ButtonHeight">34</sys:Double>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="CompactHeight">28</sys:Double>
    <!-- Sidebar chrome widths: expanded matches the page-column rhythm, collapsed is the
         icon rail. Doubles so both the Border width and the collapse animation read them. -->
    <sys:Double x:Key="SidebarWidth">264</sys:Double>
    <sys:Double x:Key="SidebarCollapsedWidth">60</sys:Double>
    <!-- Standard width for the context/inspector columns flanking a workspace stage; a
         GridLength so column definitions can take it directly. -->
    <GridLength x:Key="SidePanelWidth">256</GridLength>
    <Thickness x:Key="PagePadding">32,20,32,32</Thickness>
    <!-- Corner radius of floating surfaces (toasts, flyouts): between chip and card. -->
    <CornerRadius x:Key="RadiusFloating">10</CornerRadius>

    <!-- Floating surfaces use one of exactly two elevations: FloatingShadow for popups,
         flyouts and toasts, ModalShadow for the confirmation card. -->
    <DropShadowEffect x:Key="FloatingShadow" ShadowDepth="6" BlurRadius="18" Opacity="0.45"
                      Color="#000000" po:Freeze="True" />
    <DropShadowEffect x:Key="ModalShadow" ShadowDepth="10" BlurRadius="32" Opacity="0.5"
                      Color="#000000" po:Freeze="True" />

    <!-- Disc palette for the three custom canvases (annulus preview, design canvas,
         calibration photo canvas). Both disc diagrams draw the same body/hub/ring, so the
         colors belong to the theme rather than to each control. -->
    <SolidColorBrush x:Key="DiscCanvasBackdropBrush" Color="#0D0D0F" />
    <SolidColorBrush x:Key="DiscBodyBrush" Color="#1C1C20" />
    <SolidColorBrush x:Key="DiscHubBrush" Color="#0D0D0F" />
    <SolidColorBrush x:Key="DiscRingBrush" Color="#303385FF" />
    <SolidColorBrush x:Key="DiscGuideBrush" Color="#55A1A1AA" />
    <SolidColorBrush x:Key="DiscMaskBrush" Color="#88000000" />
    <SolidColorBrush x:Key="DiscSelectionBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="CalibrationPhotoBackdropBrush" Color="#13151A" />
    <SolidColorBrush x:Key="CalibrationCaptionBrush" Color="#DC13151A" />
    <!-- Calibration annotation colors, drawn over arbitrary photos: the azure/amber pair
         marks the photo step (edge, hub), the cyan/amber pair the trace step (observed
         input, model prediction). Derived from the brand hue family and the warning ramp
         instead of raw web primaries, so overlays read as part of the same palette while
         keeping enough contrast on both light photos and the dark backdrop. -->
    <SolidColorBrush x:Key="CalibrationEdgeBrush" Color="#74C0FF" />
    <SolidColorBrush x:Key="CalibrationHubOutlineBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CalibrationTraceBrush" Color="#22D3EE" />
    <SolidColorBrush x:Key="CalibrationPredictionBrush" Color="#FFA94D" />
    <SolidColorBrush x:Key="CalibrationHandleBrush" Color="#D4D4D8" />
    <SolidColorBrush x:Key="CalibrationOutlineBrush" Color="#000000" />

    <!-- Fonts: embedded HarmonyOS Sans SC covers Latin + CJK for the whole UI; Cascadia Mono stays
         the terminal/log face with Microsoft YaHei UI kept as the last system fallback. -->
    <FontFamily x:Key="AppFontFamily">
        pack://application:,,,/Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC,
        pack://application:,,,/Assets/Fonts/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC,
        pack://application:,,,/Assets/Fonts/HarmonyOS_Sans_SC_Bold.ttf#HarmonyOS Sans SC,
        Microsoft YaHei UI, Segoe UI
    </FontFamily>
    <FontFamily x:Key="MonoFontFamily">
        Cascadia Mono, Consolas,
        pack://application:,,,/Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC,
        Microsoft YaHei UI
    </FontFamily>

    <!-- App icon art -->
    <ImageSource x:Key="AppIconSource">pack://application:,,,/Assets/DiscImageStudio-256.png</ImageSource>

    <!-- Window control glyphs (10x10, 1px strokes, aligned to the reference chrome).
         Every content icon (navigation, cards, dialogs) comes from the Lucide set via
         MahApps.Metro.IconPacks; only these chrome glyphs stay hand-drawn. -->
    <Geometry x:Key="WinMinimizeIcon">M0,0.5 H10</Geometry>
    <Geometry x:Key="WinMaximizeIcon">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
    <Geometry x:Key="WinRestoreIcon">M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5</Geometry>
    <Geometry x:Key="WinCloseIcon">M0,0 L10,10 M10,0 L0,10</Geometry>
    <!-- App-menu ellipsis: three 2px dots on a 4px pitch. The icon grid's dots read heavier
         than the 1px window-control strokes, so this one is drawn at chrome weight. -->
    <GeometryGroup x:Key="WinEllipsisIcon">
        <EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="5,1" RadiusX="1" RadiusY="1" />
        <EllipseGeometry Center="9,1" RadiusX="1" RadiusY="1" />
    </GeometryGroup>

</ResourceDictionary>
