<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light overlay for the design tokens. It sits between Tokens.xaml (dark source) and
      Controls.xaml in the merged dictionaries, so every key here wins while it is loaded
      and disappears again when ThemeResolver removes the dictionary. Every Color and Brush
      key from Tokens.xaml must be overridden; ThemePaletteTests enforces that.
    -->

    <Color x:Key="BackgroundColor">#F5F5F7</Color>
    <Color x:Key="Surface1Color">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#ECECEF</Color>
    <Color x:Key="Surface3Color">#E2E2E6</Color>
    <Color x:Key="DividerColor">#1A000000</Color>
    <Color x:Key="TextPrimaryColor">#18181B</Color>
    <Color x:Key="TextSecondaryColor">#52525B</Color>
    <Color x:Key="TextMutedColor">#71717A</Color>
    <!-- On light surfaces the base blue is darkened for white text on filled buttons;
         hover and pressed step further down rather than up. -->
    <Color x:Key="PrimaryColor">#2569CC</Color>
    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="PrimaryHoverColor">#1D5BB4</Color>
    <Color x:Key="PrimaryPressedColor">#16488F</Color>
    <Color x:Key="PrimarySoftColor">#1F2569CC</Color>
    <Color x:Key="DangerColor">#D61F4E</Color>
    <Color x:Key="DangerHoverColor">#B81642</Color>
    <Color x:Key="DangerPressedColor">#9C0F36</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="SuccessColor">#15803D</Color>
    <Color x:Key="CloseHotColor">#C42B1C</Color>
    <Color x:Key="ScrollbarThumbColor">#C7C7CC</Color>
    <Color x:Key="ScrollbarThumbHoverColor">#A1A1AA</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="CloseHotBrush" Color="{StaticResource CloseHotColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="{StaticResource ScrollbarThumbHoverColor}" />

    <Color x:Key="BackgroundFadeColor">#00F5F5F7</Color>
    <LinearGradientBrush x:Key="ScrollFadeTopBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundFadeColor}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollFadeBottomBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BackgroundFadeColor}" Offset="0" />
        <GradientStop Color="{StaticResource BackgroundColor}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#08000000" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000" />
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="BackdropBrush" Color="#66000000" />
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#4D2569CC" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1FB45309" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#66B45309" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5205" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD61F4E" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#66D61F4E" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F15803D" />
    <SolidColorBrush x:Key="CloseHotSoftBrush" Color="#E6C42B1C" />

    <Color x:Key="SurfaceHoverColor">#EBEBEF</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />

    <SolidColorBrush x:Key="BadgeSurfaceBrush" Color="#CCFFFFFF" />

    <Color x:Key="ShineClearColor">#00000000</Color>
    <Color x:Key="ShineSoftColor">#1A000000</Color>
    <Color x:Key="ShineCoreColor">#40000000</Color>

    <Color x:Key="Surface1FadeColor">#00FFFFFF</Color>

    <!-- Canvases: the disc body turns white, the work surface a soft gray. Annotations keep
         their hue families but darken so they stay legible over bright photos. -->
    <SolidColorBrush x:Key="DiscCanvasBackdropBrush" Color="#E6E6EA" />
    <SolidColorBrush x:Key="DiscBodyBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DiscHubBrush" Color="#E2E2E6" />
    <SolidColorBrush x:Key="DiscRingBrush" Color="#302569CC" />
    <SolidColorBrush x:Key="DiscGuideBrush" Color="#5571717A" />
    <SolidColorBrush x:Key="DiscMaskBrush" Color="#66000000" />
    <SolidColorBrush x:Key="DiscSelectionBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="CalibrationPhotoBackdropBrush" Color="#D9DADE" />
    <SolidColorBrush x:Key="CalibrationCaptionBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="CalibrationEdgeBrush" Color="#0B66D0" />
    <SolidColorBrush x:Key="CalibrationHubOutlineBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CalibrationTraceBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="CalibrationPredictionBrush" Color="#C2410C" />
    <SolidColorBrush x:Key="CalibrationHandleBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="CalibrationOutlineBrush" Color="#000000" />

</ResourceDictionary>
