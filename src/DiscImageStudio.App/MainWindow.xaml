<Window x:Class="DiscImageStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiscImageStudio.Localization"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Disc Image Studio"
        Width="1240" Height="780" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- About remains in the shared application menu. Settings has a direct title-bar button. -->
        <ContextMenu x:Key="AppMenu">
            <MenuItem Header="{loc:Text Xaml.About2}" Click="AppMenuAbout_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="{Binding ProjectTitleDisplay}"
                           ShowSettingsButton="True" SettingsRequested="Settings_Click"
                           ShowAppMenu="True" AppMenuRequested="TitleBar_AppMenuRequested" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: the workspace switcher, visible exactly when a workspace shows (the
                 home start screen owns the whole window). -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="{StaticResource SidebarWidth}"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" ClipToBounds="True"
                    Visibility="Collapsed">
                <Grid x:Name="SidebarGrid" Margin="24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TopNavPanel" Grid.Row="0" VerticalAlignment="Top" Margin="0,16,0,0">
                        <!-- Project header: back-home button, name (click to edit settings),
                             family badge and the unsaved mark. -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackHomeButton" Style="{StaticResource GhostButton}"
                                    Width="32" Height="32" Padding="0" Focusable="False"
                                    AutomationProperties.Name="{loc:Text Xaml.BackToHome}" ToolTip="{loc:Text Xaml.BackToHome}"
                                    Command="{Binding BackHomeCommand}">
                                <iconPacks:PackIconLucide Kind="ChevronLeft" Width="17" Height="17"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Button>
                            <Grid x:Name="ProjectHeaderHost" Grid.Column="1" Margin="8,0,0,0">
                                <Button x:Name="ProjectHeaderButton" Style="{StaticResource TileButton}"
                                        Padding="6,2" Focusable="False"
                                        ToolTip="{loc:Text Xaml.ProjectSettings}"
                                        Click="EditProject_Click">
                                    <StackPanel>
                                        <TextBlock x:Name="ProjectNameText" FontSize="14" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Padding="5,1" CornerRadius="5"
                                                    Background="{DynamicResource Surface3Brush}">
                                                <TextBlock x:Name="ProjectFamilyText"
                                                           Style="{StaticResource BadgeText}" />
                                            </Border>
                                            <TextBlock x:Name="ProjectDirtyText" Text="{loc:Text Xaml.Unsaved}"
                                                       Style="{StaticResource MicroText}"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Margin="6,0,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <!-- Applied-calibration acknowledgement: a card-like light band
                                     sweeps the project header once, while a short "parameters
                                     updated" tag fades in and out. Both are presentation only and
                                     never take hit testing from the project button. -->
                                <Border x:Name="ProjectUpdateShine" CornerRadius="8" ClipToBounds="True"
                                        IsHitTestVisible="False" Opacity="0">
                                    <Rectangle x:Name="ProjectUpdateShineBand" Width="96"
                                               HorizontalAlignment="Left">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource ShineClearColor}" Offset="0" />
                                                <GradientStop Color="{DynamicResource ShineSoftColor}" Offset="0.42" />
                                                <GradientStop Color="{DynamicResource ShineCoreColor}" Offset="0.5" />
                                                <GradientStop Color="{DynamicResource ShineSoftColor}" Offset="0.58" />
                                                <GradientStop Color="{DynamicResource ShineClearColor}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-18" />
                                                <TranslateTransform x:Name="ProjectUpdateShineTranslate" />
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                                <Border x:Name="ProjectUpdateBadge" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="0,0,4,1"
                                        Padding="6,2" CornerRadius="{StaticResource RadiusChip}"
                                        Background="{DynamicResource SuccessSoftBrush}"
                                        BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1"
                                        IsHitTestVisible="False" Opacity="0">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconLucide Kind="Check" Width="10" Height="10"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{loc:Text Xaml.ParametersUpdated}" Style="{StaticResource BadgeText}"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <!-- Saved acknowledgement: one green segment runs a single
                                     lap around the header. The head follows a cubic Bezier
                                     timing curve and the tail stretches with its speed, so the
                                     stroke reads as a comet instead of a uniform ring. The
                                     applied-calibration sweep above remains the louder signal. -->
                                <controls:ProjectSaveTrail x:Name="ProjectSaveTrail"
                                                           Stroke="{DynamicResource SuccessBrush}"
                                                           CornerRadius="8" />
                            </Grid>
                        </Grid>

                        <!-- Icon-only rows keep the collapsed 60px bar a flat rail. -->
                        <controls:SideNavItem x:Name="NavDesign" LabelText="{loc:Text Xaml.Design}"
                                              IconKind="Palette" />
                        <controls:SideNavItem x:Name="NavPreview" LabelText="{loc:Text Xaml.Preview}"
                                              IconKind="Eye" />
                        <controls:SideNavItem x:Name="NavExport" LabelText="{loc:Text Xaml.Export}"
                                              IconKind="FileDown" />
                        <controls:SideNavItem x:Name="NavBurn" LabelText="{loc:Text Xaml.Burn}"
                                              IconKind="Flame" />
                        <controls:SideNavItem x:Name="NavCalibration" LabelText="{loc:Text Xaml.Calibration}"
                                              IconKind="Crosshair" />
                    </StackPanel>

                    <Button x:Name="SidebarCollapseToggle" Grid.Row="1" Height="40" Margin="0,8,0,16"
                            Style="{StaticResource GhostButton}" Padding="0" Focusable="False"
                            ToolTip="{loc:Text Xaml.CollapseSidebar}" Click="SidebarCollapseToggle_Click">
                        <Grid>
                            <iconPacks:PackIconLucide x:Name="CollapseLeftIcon" Kind="ChevronLeft"
                                                      Width="20" Height="20" HorizontalAlignment="Left"
                                                      Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <iconPacks:PackIconLucide x:Name="CollapseRightIcon" Kind="ChevronRight"
                                                      Width="20" Height="20" HorizontalAlignment="Center"
                                                      Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Page host + the job dock. The dock belongs to the chrome: jobs report there
                 instead of switching the visible workspace. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="PageHost" Grid.Row="0" Focusable="False" />
                <controls:JobDock x:Name="DockHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Toasts: top-right, over pages and sidebar -->
        <controls:ToastHost Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,40,16,0" Panel.ZIndex="20" />

        <!-- Confirmation modal overlay (burn confirm + unsaved-changes dialog) -->
        <controls:ConfirmModal x:Name="BurnConfirmModal" Grid.Row="0" Grid.RowSpan="2"
                               Panel.ZIndex="30" />
    </Grid>
</Window>
