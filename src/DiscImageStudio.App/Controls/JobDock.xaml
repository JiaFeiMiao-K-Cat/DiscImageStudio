<UserControl x:Class="DiscImageStudio.Controls.JobDock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <!-- Shell-level task strip. It lives in the window chrome rather than on a page so a job
         never navigates the user away from the workspace it was started from: the collapsed
         strip shows what is running and what it produced, and the expanded strip is the log. -->
    <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide x:Name="StatusIcon" Grid.Column="0" Kind="CircleCheck"
                                          Width="16" Height="16" VerticalAlignment="Center"
                                          Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding JobTitle}" Style="{StaticResource CompactText}"
                           VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="10,0,10,0" />
                <TextBlock Grid.Column="2" Text="{Binding JobStatusText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CompactHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBurnTelemetryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Column="3"
                             Width="180" VerticalAlignment="Center" Margin="0,0,16,0"
                             IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                             Minimum="0" Maximum="100"
                             Value="{Binding JobProgressValue, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar" BasedOn="{StaticResource CompactProgressBar}">
                            <Setter Property="Visibility" Value="{Binding JobProgressVisibility}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBurnTelemetryVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CompactButton}" Content="取消"
                            Command="{Binding CancelJobCommand}" Margin="0,0,8,0"
                            Visibility="{Binding CancelJobVisibility}"
                            ToolTip="停止正在运行且支持取消的任务。" />
                    <!-- Result and log actions appear with the thing they act on: a project with
                         nothing generated yet shows only the status line. -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding ResultActionsVisibility}">
                        <Button Style="{StaticResource CompactButton}" Content="打开输出位置"
                                Command="{Binding OpenOutputCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource CompactButton}" Content="查看读回预览"
                                Command="{Binding PreviewLastOutputCommand}" Margin="0,0,8,0"
                                Visibility="{Binding CanPreviewLastOutputVisibility}"
                                ToolTip="把最近生成的文件作为输入镜像，在预览工作区模拟读回。" />
                    </StackPanel>
                    <Button Style="{StaticResource CompactButton}" Content="清空日志"
                            Command="{Binding ClearLogCommand}" Margin="0,0,8,0"
                            Visibility="{Binding LogActionsVisibility}" />
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleJobDockCommand}"
                            AutomationProperties.Name="任务详情" ToolTip="任务详情 / 运行日志"
                            Visibility="{Binding DockToggleVisibility}">
                        <!-- Collapsed points up (tap to expand); expanded points down
                             (tap to collapse), matching every bottom-dock convention. -->
                        <iconPacks:PackIconLucide Kind="ChevronUp" Width="16" Height="16"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Foreground="{StaticResource TextSecondaryBrush}">
                            <iconPacks:PackIconLucide.Style>
                                <Style TargetType="iconPacks:PackIconLucide">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsJobDockExpanded}" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </iconPacks:PackIconLucide.Style>
                        </iconPacks:PackIconLucide>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="14,0,14,10"
                        Visibility="{Binding IsBurnTelemetryVisible, Converter={StaticResource BoolToVisibility}}">
                <WrapPanel Margin="0,0,0,8" TextElement.FontFamily="{StaticResource MonoFontFamily}"
                           TextElement.FontSize="12" TextElement.Foreground="{StaticResource TextPrimaryBrush}">
                    <TextBlock Text="{Binding BurnAmountText}" Margin="0,0,24,0" />
                    <TextBlock Text="{Binding BurnRateText}" Margin="0,0,24,0" />
                    <TextBlock Text="{Binding BurnMultiplierText}" />
                </WrapPanel>
                <ProgressBar Style="{StaticResource CompactProgressBar}" Minimum="0" Maximum="100"
                             Value="{Binding JobProgressValue, Mode=OneWay}" IsIndeterminate="False" />
            </StackPanel>

            <Border Grid.Row="2" x:Name="LogHost" Height="200" Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsJobDockExpanded, Converter={StaticResource BoolToVisibility}}">
                <TextBox x:Name="LogTextBox" Style="{StaticResource BareTextBox}" IsReadOnly="True"
                         AcceptsReturn="True" VerticalAlignment="Stretch"
                         FontFamily="{StaticResource MonoFontFamily}" FontSize="12"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" Padding="14,8,14,8" />
            </Border>
        </Grid>
    </Border>
</UserControl>
