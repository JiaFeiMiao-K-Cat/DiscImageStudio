<UserControl x:Class="DiscImageStudio.Controls.PathField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <!-- One path-row recipe (label + field + browse) for the ~6 places that used to retype
         TextBox + BrowseButton with drifting widths. Compact=true switches the row to the
         inspector density (36px). -->
    <StackPanel>
        <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabel}"
                   Visibility="Collapsed" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathTextBox">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType={x:Type controls:PathField}}}"
                                         Value="True">
                                <Setter Property="Height" Value="{StaticResource CompactHeight}" />
                                <Setter Property="FontSize" Value="13" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>
            <!-- Watermark for a field whose empty value means "use the default": it shows that
                 default in place of the path until the user types or focuses the field. The
                 inset matches the TextBox template (2px border margin + 1px stroke + 10px
                 padding). -->
            <TextBlock x:Name="PlaceholderTextBlock" Margin="13,0,12,0" IsHitTestVisible="False"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="{Binding FontSize, ElementName=PathTextBox}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=PathTextBox}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PathTextBox}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource BrowseButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Compact, RelativeSource={RelativeSource AncestorType={x:Type controls:PathField}}}"
                                         Value="True">
                                <Setter Property="Height" Value="{StaticResource CompactHeight}" />
                                <Setter Property="FontSize" Value="13" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <TextBlock x:Name="HintTextBlock" Style="{StaticResource CompactHint}" Margin="0,6,0,0"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
