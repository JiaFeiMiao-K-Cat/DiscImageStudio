<UserControl x:Class="DiscImageStudio.Controls.EmptyStateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- In-place guidance for a surface with nothing to show yet: what is missing, why, and
         the one action that fills the gap. Free navigation stays intact (no stage gates) —
         this only makes the next step reachable from where the user is standing. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
        <Border Width="64" Height="64" CornerRadius="{StaticResource RadiusPanel}"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                HorizontalAlignment="Center">
            <iconPacks:PackIconLucide x:Name="IconHost" Width="28" Height="28"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Foreground="{DynamicResource TextMutedBrush}" />
        </Border>
        <TextBlock x:Name="TitleText" Style="{StaticResource RowText}" FontWeight="Medium"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock x:Name="DescriptionText" Style="{StaticResource HintText}" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0" />
        <Button x:Name="ActionButton" Style="{StaticResource CompactButton}"
                HorizontalAlignment="Center" Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
