<UserControl x:Class="DiscImageStudio.Controls.StageBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The workflow rail under the page header: design → preview → export → burn, with
         calibration as the branch that feeds back into it. Every workspace shows the whole
         path, the current stage is highlighted, and every stage is clickable — the same
         navigation the sidebar offers, expressed inside the page itself. -->
    <ItemsControl x:Name="StageList">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal">
                    <!-- The branch divider separates calibration from the linear chain. -->
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource DividerBrush}"
                               Margin="12,0,6,0" VerticalAlignment="Center"
                               Visibility="{Binding BranchVisibility}" />
                    <Button Click="Stage_Click" Focusable="False" Cursor="Hand"
                            AutomationProperties.Name="{Binding Label}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Hot" Background="Transparent"
                                        CornerRadius="{StaticResource RadiusChip}" Padding="8,4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hot" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Hot" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="18" Height="18">
                                <Border x:Name="Dot" CornerRadius="9" Background="{DynamicResource Surface2Brush}" />
                                <TextBlock x:Name="IndexText" Text="{Binding IndexText}" Style="{StaticResource MicroText}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </Grid>
                            <TextBlock x:Name="StageLabel" Text="{Binding Label}" Style="{StaticResource InlineText}"
                                       Margin="7,0,2,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <DataTemplate.Triggers>
                    <!-- The rail marks where you are, not what is finished: earlier stages keep
                         their muted number instead of a check mark, because reaching a stage is
                         not the same as having completed it. -->
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                        <!-- The number sits on the blue fill, so it takes the on-primary
                             label white; TextPrimaryBrush turns dark in the light theme. -->
                        <Setter TargetName="IndexText" Property="Foreground" Value="White" />
                        <Setter TargetName="StageLabel" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        <Setter TargetName="StageLabel" Property="FontWeight" Value="Medium" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
