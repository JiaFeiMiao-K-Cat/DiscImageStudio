<UserControl x:Class="DiscImageStudio.Controls.TonePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls">
    <!-- Tone module for the design page's 280 px rail and the full-width rail it becomes
         below the page breakpoint. The preview is a caption-less centered medallion: the
         module title above carries the context, so no second title lives in the card.
         Narrow form: the preview fills the module's spare height and the controls sit
         below. Wide form: a larger disc on the left, controls on the right. -->
    <Grid x:Name="ToneLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            <ColumnDefinition x:Name="GapColumn" Width="0" />
            <ColumnDefinition x:Name="ControlsColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="ModuleTitle" Grid.Row="0" Grid.ColumnSpan="3"
                   Text="{loc:Text Xaml.Tone}" Style="{StaticResource PanelTitle}" Margin="0,0,0,12" />

        <Border x:Name="TonePreviewCard" Grid.Row="1" Grid.Column="0"
                Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusPanel}" Padding="10">
            <!-- Each renderer supplies the recording-area alpha mask. Display the full
                 bitmap so custom radii and file regions retain their physical bounds. -->
            <Grid x:Name="PreviewImageHost" Width="128" Height="128"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PreviewDisc" Source="{Binding TonePreviewImage}" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTonePreview}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Ellipse Fill="{DynamicResource Surface1Brush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTonePreview}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{loc:Text Xaml.NoPreview}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MicroText}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTonePreview}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Ellipse Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"
                         Margin="0.6" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <StackPanel x:Name="ToneControls" Grid.Row="2" Grid.Column="0" Margin="0,14,0,0">
            <Grid>
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{loc:Text Xaml.Dithering}" />
                <TextBlock Style="{StaticResource RowText}" HorizontalAlignment="Right"
                           Text="{Binding State.ToneDitherText}" />
            </Grid>
            <Slider Style="{StaticResource ToneSlider}" Minimum="0" Maximum="1"
                    Value="{Binding State.ToneDitherStrength, Mode=TwoWay}"
                    AutomationProperties.Name="{loc:Text Xaml.Dithering}" />

            <Grid Margin="0,12,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{loc:Text Xaml.Brightness}" />
                <TextBlock Style="{StaticResource RowText}" HorizontalAlignment="Right"
                           Text="{Binding State.ToneBrightnessText}" />
            </Grid>
            <Slider Style="{StaticResource ToneBipolarSlider}" Minimum="-64" Maximum="64"
                    Value="{Binding State.ToneBrightness, Mode=TwoWay}"
                    AutomationProperties.Name="{loc:Text Xaml.Brightness}" />

            <controls:VisibilityGate IsOpen="{Binding IsCd}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="{loc:Text Xaml.GrayLevels}" />
                    <controls:SegmentedControl LabelA="{loc:Text Xaml.2Levels}" LabelB="{loc:Text Xaml.4Levels}"
                                               HorizontalAlignment="Stretch"
                                               IsSecondSelected="{Binding State.IsFourLevelSelected}" />
                    <TextBlock Style="{StaticResource CompactHint}" Margin="0,4,0,0"
                               Text="{loc:Text Xaml.FourLevelsUseFourTonesToRevealFinerDetails}" />
                </StackPanel>
            </controls:VisibilityGate>

            <CheckBox Margin="0,12,0,0" Content="{loc:Text Xaml.SRGBLinearizationGamma}"
                      IsChecked="{Binding State.ToneSrgbLinearization, Mode=TwoWay}"
                      AutomationProperties.Name="{loc:Text Xaml.SRGBLinearization}" />
            <TextBlock Style="{StaticResource CompactHint}" Margin="0,4,0,0"
                       Text="{loc:Text Xaml.MayImproveTheVisibilityOfTheDiscArtwork}" />

            <controls:VisibilityGate IsOpen="{Binding IsBluRay}" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox Content="{loc:Text Xaml.Invert3T6TMapping}"
                              IsChecked="{Binding State.BdInvertMapping, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Text Xaml.Invert3T6TMapping}" />
                    <TextBlock Style="{StaticResource CompactHint}" Margin="0,4,0,0"
                               Text="{loc:Text Xaml.SwapDarkAndLightRegionsActualDiscContrastDepends}" />
                </StackPanel>
            </controls:VisibilityGate>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource CompactButton}" Content="{loc:Text Xaml.ResetDefaults}"
                        Command="{Binding ResetToneCommand}" />
                <Button Style="{StaticResource CompactButton}" Content="{loc:Text Xaml.RefreshPreview}"
                        Command="{Binding RefreshTonePreviewCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
