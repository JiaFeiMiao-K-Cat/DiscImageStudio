<UserControl x:Class="DiscImageStudio.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             IsHitTestVisible="False">
    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="ToastCard" Width="320" Margin="0,0,0,10" HorizontalAlignment="Right"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusFloating}" Padding="12,10,8,10" SnapsToDevicePixels="True"
                        Effect="{StaticResource FloatingShadow}"
                        IsHitTestVisible="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="Slide" X="24" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                                                     From="24" To="0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0" To="1" Duration="0:0:0.25" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="KindBar" Width="3" CornerRadius="1.5" Margin="0,2,12,2" />
                        <StackPanel Grid.Column="1" Margin="0,0,20,0">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource CompactText}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <!-- Manual dismiss: the host itself stays hit-test-invisible so empty
                             toast area keeps passing clicks through to the page underneath. -->
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                AutomationProperties.Name="关闭通知" ToolTip="关闭"
                                Click="CloseToast_Click">
                            <iconPacks:PackIconLucide Kind="X" Width="14" Height="14"
                                                      Foreground="{DynamicResource TextMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource SuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource WarningBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource DangerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Info">
                        <Setter TargetName="KindBar" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
