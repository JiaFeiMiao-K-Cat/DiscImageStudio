<UserControl x:Class="DiscImageStudio.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization">
    <Grid Height="32" Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Margin="12,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="{StaticResource AppIconSource}" Width="16" Height="16" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Disc Image Studio" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="ProjectTitleText" Grid.Column="2" FontSize="12" Margin="8,0,0,0" Visibility="Collapsed"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel x:Name="WindowButtons" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="SettingsButton" Height="26" MinWidth="76" Padding="12,0" Margin="8,3,6,3"
                    FontSize="12" Click="Settings_Click" Visibility="Collapsed"
                    ToolTip="{loc:Text Xaml.OpenSettingsShortcut}"
                    AutomationProperties.Name="{loc:Text Xaml.SettingsButton}"
                    AutomationProperties.AcceleratorKey="Ctrl+,">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Kind="Settings" Width="14" Height="14"
                                              Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text Xaml.SettingsButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Application menu sits left of the window buttons; hidden on dialogs that do
                 not opt in through ShowAppMenu. -->
            <Button x:Name="AppMenuButton" Width="46" Height="32" Focusable="False"
                    Click="AppMenu_Click" ToolTip="{loc:Text Xaml.AppMenu}"
                    AutomationProperties.Name="{loc:Text Xaml.AppMenu}" Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Path Data="{StaticResource WinEllipsisIcon}"
                                  Fill="{DynamicResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="MinimizeButton" Width="46" Height="32" Focusable="False" Click="Minimize_Click"
                    ToolTip="{loc:Text Xaml.Minimize}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Path Data="{StaticResource WinMinimizeIcon}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"
                                  Width="10" Height="1" Stretch="None" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="MaximizeButton" Width="46" Height="32" Focusable="False" Click="Maximize_Click"
                    ToolTip="{loc:Text Xaml.Maximize}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Grid Width="10" Height="10">
                                <Path x:Name="MaximizeGlyph" Data="{StaticResource WinMaximizeIcon}" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1" Stretch="None" />
                                <Path x:Name="RestoreGlyph" Data="{StaticResource WinRestoreIcon}" Stroke="{DynamicResource TextPrimaryBrush}"
                                      StrokeThickness="1" Stretch="None" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource TitleBarHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource PressedOverlayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="CloseButton" Width="46" Height="32" Focusable="False" Click="Close_Click" ToolTip="{loc:Text Xaml.Close}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hot" Background="Transparent">
                            <Path Data="{StaticResource WinCloseIcon}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"
                                  Width="10" Height="10" Stretch="None" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource CloseHotSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hot" Property="Background" Value="{DynamicResource CloseHotBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
