<UserControl x:Class="DiscImageStudio.Controls.HelpHint"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 20px circular help hotspot: hover lights the glyph and ring, the hint sentence
         shows as its tooltip. The hover colors are animated in code because a XAML
         ColorAnimation captures a fixed palette value and would not follow a theme
         switch. -->
    <Grid x:Name="Root" Width="20" Height="20" Background="Transparent" Cursor="Hand"
          ToolTipService.InitialShowDelay="150">
        <Border x:Name="HelpCircle" CornerRadius="10"
                Background="{DynamicResource PrimarySoftBrush}" Opacity="0" />
        <TextBlock x:Name="HelpGlyph" Text="?" FontSize="14"
                   TextAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Foreground>
                <SolidColorBrush Color="{DynamicResource TextMutedColor}" />
            </TextBlock.Foreground>
        </TextBlock>
    </Grid>
</UserControl>
