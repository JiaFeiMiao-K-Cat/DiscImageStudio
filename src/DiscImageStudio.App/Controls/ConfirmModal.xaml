<UserControl x:Class="DiscImageStudio.Controls.ConfirmModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Focusable="False">
    <Grid x:Name="Root" Visibility="Collapsed">
        <Rectangle x:Name="Backdrop" Fill="{DynamicResource BackdropBrush}" />
        <Border x:Name="DialogCard" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Surface1Brush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusCard}" Padding="18" SnapsToDevicePixels="True"
                Effect="{StaticResource ModalShadow}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide x:Name="HeaderIcon" Kind="TriangleAlert" Width="24" Height="24"
                                              Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource CardTitle}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CancelButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                            Content="取消" Click="Cancel_Click" />
                    <!-- Three-way save dialog only: sits between refuse (cancel) and the
                         constructive action, hidden for the two-button burn confirm. -->
                    <Button x:Name="NeutralButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                            Content="不保存" Visibility="Collapsed" Click="Neutral_Click" />
                    <Button x:Name="ConfirmButton" Grid.Column="4" Style="{StaticResource DangerButton}"
                            Content="确认刻录" Click="Confirm_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
