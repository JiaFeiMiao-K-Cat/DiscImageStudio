<UserControl x:Class="DiscImageStudio.Controls.SideNavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Focusable="True" IsTabStop="True"
             FocusVisualStyle="{DynamicResource FocusRing}">
    <Border x:Name="Root" Height="40" CornerRadius="0" Background="Transparent" Cursor="Hand"
            SnapsToDevicePixels="True">
        <Grid>
            <Border Width="3" Height="24" CornerRadius="0" HorizontalAlignment="Left"
                    VerticalAlignment="Center" IsHitTestVisible="False"
                    Background="{DynamicResource PrimaryBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <StackPanel x:Name="ItemContent" Orientation="Horizontal" Margin="12,0"
                        VerticalAlignment="Center">
                <iconPacks:PackIconLucide x:Name="Icon" Width="18" Height="18" Visibility="Collapsed" />
                <TextBlock x:Name="LabelTextBlock" Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
