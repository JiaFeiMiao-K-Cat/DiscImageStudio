<UserControl x:Class="DiscImageStudio.Controls.SegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="SegmentedRoot"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             MinWidth="160">
    <!-- Field height: the selector is an input control, so it shares ControlHeight with the
         TextBox/ComboBox instead of riding the denser CompactHeight used by tool rows. -->
    <Grid x:Name="LayoutRoot" Height="{StaticResource ControlHeight}">
        <!-- Rounded-rect track one level above the card surface, divider hairline;
             8px radius matches the TextBox/ComboBox field language (not a pill) -->
        <Border CornerRadius="8" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" />
        <!-- Inner well: inset 3 keeps thumb and focus ring inside the rounded silhouette -->
        <Grid x:Name="Cells" Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ThirdColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <!-- Sliding selection thumb; code-behind translates it between the two equal cells.
                 The selected cell is the brand fill, not a neutral raised surface: on a dark
                 track a gray thumb reads as "disabled" rather than "chosen". -->
            <Border x:Name="Thumb" Grid.Column="0" Margin="3" CornerRadius="6"
                    Background="{DynamicResource PrimaryBrush}"
                    BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ThumbShift" />
                </Border.RenderTransform>
            </Border>
            <RadioButton x:Name="OptionARadio" Grid.Column="0" Margin="3" Cursor="Hand"
                         Click="OptionAClick" KeyDown="OptionKeyDown"
                         MouseEnter="OptionMouseEnter" MouseLeave="OptionMouseLeave">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <!-- Focus ring hugs the rounded half-cell; the unchecked box itself
                                 carries no other chrome -->
                            <Border x:Name="FocusRing" CornerRadius="7" BorderThickness="2"
                                    Background="Transparent" BorderBrush="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
                <TextBlock x:Name="OptionAText" FontSize="14" FontWeight="Medium"
                           Text="{Binding LabelA, ElementName=SegmentedRoot}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </RadioButton>
            <RadioButton x:Name="OptionBRadio" Grid.Column="1" Margin="3" Cursor="Hand"
                         Click="OptionBClick" KeyDown="OptionKeyDown"
                         MouseEnter="OptionMouseEnter" MouseLeave="OptionMouseLeave">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="FocusRing" CornerRadius="7" BorderThickness="2"
                                    Background="Transparent" BorderBrush="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
                <TextBlock x:Name="OptionBText" FontSize="14" FontWeight="Medium"
                           Text="{Binding LabelB, ElementName=SegmentedRoot}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </RadioButton>
            <RadioButton x:Name="OptionCRadio" Grid.Column="2" Margin="3" Cursor="Hand"
                         Visibility="Collapsed"
                         Click="OptionCClick" KeyDown="OptionKeyDown"
                         MouseEnter="OptionMouseEnter" MouseLeave="OptionMouseLeave">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="FocusRing" CornerRadius="7" BorderThickness="2"
                                    Background="Transparent" BorderBrush="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
                <TextBlock x:Name="OptionCText" FontSize="14" FontWeight="Medium"
                           Text="{Binding LabelC, ElementName=SegmentedRoot}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
            </RadioButton>
        </Grid>
    </Grid>
</UserControl>
