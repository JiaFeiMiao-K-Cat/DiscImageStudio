<Window x:Class="DiscImageStudio.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        Title="设置"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="设置"
                           ShowMinimizeButton="False" ShowMaximizeButton="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                    Padding="16,12">
                <StackPanel>
                    <controls:SideNavItem x:Name="GeneralNav" LabelText="通用"
                                          IconKind="SlidersHorizontal" IsActive="True"
                                          Activated="GeneralNav_Activated" />
                    <controls:SideNavItem x:Name="StorageNav" LabelText="存储"
                                          IconKind="HardDrive" Activated="StorageNav_Activated" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,16,24,24">
                    <StackPanel x:Name="GeneralPanel">
                        <TextBlock Text="通用" Style="{StaticResource H1Title}" />
                        <TextBlock Text="界面外观偏好。" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />

                        <controls:SectionCard Header="外观" IconKind="Palette" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="主题" Style="{StaticResource FieldLabel}" />
                                <controls:SegmentedControl LabelA="深色" LabelB="浅色" LabelC="跟随系统"
                                                           SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                                <TextBlock Text="保存后立即应用到所有窗口。"
                                           Style="{StaticResource CompactHint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </controls:SectionCard>
                    </StackPanel>

                    <StackPanel x:Name="StoragePanel" Visibility="Collapsed">
                        <TextBlock Text="存储" Style="{StaticResource H1Title}" />
                        <TextBlock Text="新建工程与临时缓存的默认位置。"
                                   Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />

                        <controls:SectionCard Header="位置" IconKind="FolderCog" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="默认工程位置" Style="{StaticResource FieldLabel}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <Button Content="恢复默认" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Right" Height="24" Padding="8,0" FontSize="12"
                                            Command="{Binding ResetDefaultProjectDirectoryCommand}" />
                                </Grid>
                                <controls:PathField
                                    Text="{Binding DefaultProjectDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="{Binding DefaultProjectDirectoryPlaceholder}"
                                    Command="{Binding BrowseDefaultProjectDirectoryCommand}"
                                    Hint="仅作为新建工程对话框的默认位置；留空使用系统文档目录。" />

                                <Grid Margin="0,18,0,6">
                                    <TextBlock Text="缓存位置" Style="{StaticResource FieldLabel}"
                                               Margin="0" VerticalAlignment="Center" />
                                    <Button Content="恢复默认" Style="{StaticResource QuietButton}"
                                            HorizontalAlignment="Right" Height="24" Padding="8,0" FontSize="12"
                                            Command="{Binding ResetCacheDirectoryCommand}" />
                                </Grid>
                                <controls:PathField
                                    Text="{Binding CacheDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Placeholder="{Binding DefaultCacheDirectoryPlaceholder}"
                                    Command="{Binding BrowseCacheDirectoryCommand}"
                                    Hint="用于设计合成图、预览渲染与缩略图；留空使用系统临时目录，切换后新任务使用新位置，旧缓存不会自动迁移。" />
                            </StackPanel>
                        </controls:SectionCard>

                        <controls:SectionCard Header="缓存" IconKind="Database" Margin="0,16,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CacheUsageText}" Style="{StaticResource RowText}" />
                                    <TextBlock Text="{Binding ActiveCacheDirectory}" Style="{StaticResource InlineText}"
                                               FontSize="12" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding CacheMessage}" Style="{StaticResource CompactHint}"
                                           Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="清空缓存" Style="{StaticResource CompactButton}"
                                            Command="{Binding ClearCacheCommand}" />
                                    <Button Content="打开应用数据目录" Style="{StaticResource CompactButton}"
                                            Margin="8,0,0,0" Command="{Binding OpenAppDataDirectoryCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SectionCard>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource CompactText}"
                           Foreground="{DynamicResource DangerBrush}"
                           VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="取消" Style="{StaticResource SecondaryButton}"
                        MinWidth="88" Click="Cancel_Click" />
                <Button Grid.Column="3" Content="保存" Style="{StaticResource PrimaryButton}"
                        MinWidth="88" Click="Save_Click" />
            </Grid>
        </Border>

        <controls:ConfirmModal x:Name="ClearCacheConfirm" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="30" />
    </Grid>
</Window>
