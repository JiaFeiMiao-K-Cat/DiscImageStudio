<UserControl x:Class="DiscImageStudio.Views.DesignView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels"
             SizeChanged="OnPageSizeChanged"
             Background="Transparent" AllowDrop="True"
             PreviewDragEnter="OnImageDragOver" PreviewDragOver="OnImageDragOver"
             PreviewDrop="OnImageDrop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- Property panel for the selected layer: numeric mm/°/% fields plus rename.
             Two-column compact grid instead of the old fixed 94px WrapPanel cells. -->
        <DataTemplate DataType="{x:Type vm:DesignLayerViewModel}">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.LayerName}" />
                <TextBox Style="{StaticResource CompactTextBox}"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="X (mm)" />
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding TranslateXMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Y (mm)" />
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding TranslateYMm, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.Rotation}" />
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding RotationDeg, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.Scale}" />
                        <TextBox Style="{StaticResource CompactTextBox}"
                                 Text="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <!-- One line with the full path in the tooltip: the picture itself is on the
                     canvas, so the path should not push the tone module below the rail fold. -->
                <TextBlock Style="{StaticResource HintText}" TextWrapping="NoWrap"
                           Text="{Binding ImagePath, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ImagePath, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:PageHeader Grid.Row="0" Title="{loc:Text Xaml.Design}" Badge="{Binding FamilyLabel}"
                             Workspace="{x:Static vm:Workspace.Design}">
            <controls:PageHeader.Actions>
                <Button Style="{StaticResource CompactButton}" Content="{loc:Text Xaml.NextPreview}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:Workspace.Preview}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <!-- Wide: canvas in the middle with the layer stack and the property panel flanking it.
             Narrow: the panels stack under the canvas and the page scrolls as one surface, so
             the canvas never gets squeezed to a sliver (see OnPageSizeChanged). -->
        <ScrollViewer x:Name="WorkScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnWorkScrollChanged"
                      controls:ScrollMaskBehavior.Enabled="True">
            <Grid x:Name="Workspace">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LayersColumn" Width="{StaticResource SidePanelWidth}" />
                    <ColumnDefinition x:Name="CanvasLeadColumn" Width="16" />
                    <ColumnDefinition x:Name="CanvasColumn" Width="*" />
                    <ColumnDefinition x:Name="PropsLeadColumn" Width="16" />
                    <ColumnDefinition x:Name="PropsColumn" Width="{StaticResource SidePanelWidth}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="StageRow" Height="*" />
                    <RowDefinition x:Name="LayersRow" Height="Auto" />
                    <RowDefinition x:Name="RailRow" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Files are disc contents, separate from the editable picture layers. Both
                     cards share a rail so narrow windows can stack them without shrinking
                     the layer list or obscuring the file picker. -->
                <ScrollViewer x:Name="LeftRailScroll" Grid.Row="0" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              controls:ScrollMaskBehavior.Enabled="True">
                    <Grid x:Name="LeftRail">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="260" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Layer list. Rows are selectable and drive both the canvas selection and the
                             property panel, mirroring how a selection drives the other workspaces. -->
                        <Border x:Name="LayersCard" Grid.Row="0"
                                Style="{StaticResource CardStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource CardHeaderBandStyle}">
                                    <Grid Margin="16,0,12,0">
                                        <TextBlock Text="{loc:Text Xaml.Layers}" Style="{StaticResource PanelTitle}" />
                                        <TextBlock Text="{Binding Layers.Count, StringFormat={loc:Text Xaml.LayerCountFormat}}"
                                                   Style="{StaticResource HintText}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="LayerList" Grid.Row="1" ItemsSource="{Binding Layers}"
                                         SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False"
                                         VirtualizingPanel.IsVirtualizing="False"
                                         PreviewMouseLeftButtonDown="OnLayerListPreviewMouseLeftButtonDown"
                                         PreviewMouseRightButtonDown="OnLayerListPreviewMouseRightButtonDown"
                                         PreviewMouseMove="OnLayerListPreviewMouseMove"
                                         PreviewMouseLeftButtonUp="OnLayerListPreviewMouseLeftButtonUp"
                                         LostMouseCapture="OnLayerListLostMouseCapture">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowListBoxItem}">
                                            <Setter Property="Padding" Value="10,6" />
                                            <!-- The menu opens in its own popup and cannot reach the list's
                                                 DataContext, so the row carries the command and the menu
                                                 reads it back off its placement target. -->
                                            <Setter Property="Tag"
                                                    Value="{Binding DataContext.RemoveSelectedCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <Setter Property="ContextMenu">
                                                <Setter.Value>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:Text Xaml.DeleteLayer}"
                                                                  Command="{Binding PlacementTarget.Tag,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource RadiusChip}"
                                                        Background="{DynamicResource Surface2Brush}">
                                                    <Image Source="{Binding Thumbnail}" Width="36" Height="36"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource RowText}" />
                                                    <TextBlock Style="{StaticResource MicroText}" Margin="0,2,0,0">
                                                        <Run Text="{Binding TranslateXMm, Mode=OneWay, StringFormat={}{0:F1}}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding TranslateYMm, Mode=OneWay, StringFormat={}{0:F1}}" />
                                                        <Run Text=" mm" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ToggleVisibilityCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{loc:Text Xaml.ShowOrHideLayer}"
                                                        ToolTip="{loc:Text Xaml.ShowHide}">
                                                    <iconPacks:PackIconLucide Kind="Eye" Width="15" Height="15">
                                                        <iconPacks:PackIconLucide.Style>
                                                            <Style TargetType="iconPacks:PackIconLucide">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                        <Setter Property="Kind" Value="EyeOff" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </iconPacks:PackIconLucide.Style>
                                                    </iconPacks:PackIconLucide>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <!-- The dragged row rides here, in the same cell as the list and
                                     above it. Staying inside the card's own visual tree is what
                                     keeps the mouse capture alive: a popup would open its own
                                     window and take the drag away from the list. -->
                                <Canvas x:Name="DragOverlay" Grid.Row="1" Panel.ZIndex="2"
                                        IsHitTestVisible="False" ClipToBounds="True"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <StackPanel Grid.Row="2" Margin="12,10,12,12">
                                    <Button Style="{StaticResource SecondaryButton}" Height="{StaticResource ControlHeight}"
                                            Content="{loc:Text Xaml.ImportImages}" Command="{Binding ImportImagesCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <controls:VisibilityGate x:Name="FilesCardGate" Grid.Row="1"
                                                 IsOpen="True"
                                                 SizeChanged="OnPageSizeChanged"
                                                 IsVisibleChanged="OnFilesCardVisibilityChanged">
                            <!-- Disc contents, not image layers: the folder travels with the
                                 disc and its ring position decides where the export/burn
                                 pipeline writes around it. Output file locations stay on the
                                 export page. -->
                            <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="{loc:Text Xaml.DiscFiles}" Style="{StaticResource PanelTitle}"
                                               Margin="0,0,0,12" />
                                    <!-- The data exceeds the disc capacity: the layout planner
                                         rejects it, so the canvas has no ring to draw. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                                Visibility="{Binding DataRegionOverflow, Converter={StaticResource BoolToVisibility}}">
                                        <iconPacks:PackIconLucide Kind="TriangleAlert" Width="14" Height="14"
                                                                  Foreground="{DynamicResource DangerBrush}"
                                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DataRegionOverflowText}"
                                                   Foreground="{DynamicResource DangerBrush}"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="260" />
                                    </StackPanel>
                                    <controls:VisibilityGate IsOpen="{Binding IsCd}">
                                        <StackPanel>
                                            <controls:PathField Label="{loc:Text Xaml.Folder}" Compact="True"
                                                                Text="{Binding State.CdDataDirectory}"
                                                                ToolTip="{Binding State.CdDataDirectory}"
                                                                ButtonLabel="{loc:Text Xaml.Browse}"
                                                                Command="{Binding BrowseDataCommand}" />
                                            <controls:VisibilityGate IsOpen="{Binding State.HasCdFiles}">
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="{loc:Text Xaml.FilePlacement}" Margin="0,0,0,6" />
                                                    <controls:SegmentedControl LabelA="{loc:Text Xaml.InnerRing}" LabelB="{loc:Text Xaml.OuterRing}"
                                                                               IsSecondSelected="{Binding State.CdFilesAtOuterRing}" />
                                                </StackPanel>
                                            </controls:VisibilityGate>
                                            <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                                                       Text="{loc:Text Xaml.UsesAnAudioTrackWithoutFilesSwitchesToA}" />
                                        </StackPanel>
                                    </controls:VisibilityGate>
                                    <controls:VisibilityGate IsOpen="{Binding IsDvd}">
                                        <StackPanel>
                                            <controls:PathField Label="{loc:Text Xaml.FolderOptional}" Compact="True"
                                                                Text="{Binding State.DvdDataDirectory}"
                                                                ToolTip="{Binding State.DvdDataDirectory}"
                                                                ButtonLabel="{loc:Text Xaml.Browse}"
                                                                Command="{Binding BrowseDataCommand}" />
                                            <controls:VisibilityGate IsOpen="{Binding State.HasDvdFiles}">
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="{loc:Text Xaml.FilePlacement}" Margin="0,0,0,6" />
                                                    <controls:SegmentedControl LabelA="{loc:Text Xaml.InnerRing}" LabelB="{loc:Text Xaml.OuterRing}"
                                                                               IsSecondSelected="{Binding State.DvdFilesAtOuterRing}" />
                                                </StackPanel>
                                            </controls:VisibilityGate>
                                        </StackPanel>
                                    </controls:VisibilityGate>
                                    <controls:VisibilityGate IsOpen="{Binding IsBluRay}">
                                        <StackPanel>
                                            <controls:PathField Label="{loc:Text Xaml.FolderOptional}" Compact="True"
                                                                Text="{Binding State.BdDataDirectory}"
                                                                ToolTip="{Binding State.BdDataDirectory}"
                                                                ButtonLabel="{loc:Text Xaml.Browse}"
                                                                Command="{Binding BrowseDataCommand}" />
                                            <controls:VisibilityGate IsOpen="{Binding State.HasBluRayFiles}">
                                                <StackPanel Margin="0,14,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="{loc:Text Xaml.FilePlacement}" Margin="0,0,0,6" />
                                                    <controls:SegmentedControl LabelA="{loc:Text Xaml.InnerRing}" LabelB="{loc:Text Xaml.OuterRing}"
                                                                               IsSecondSelected="{Binding State.BdFilesAtOuterRing}" />
                                                </StackPanel>
                                            </controls:VisibilityGate>
                                        </StackPanel>
                                    </controls:VisibilityGate>
                                </StackPanel>
                            </Border>
                        </controls:VisibilityGate>
                    </Grid>
                </ScrollViewer>

                <!-- Center: the mm canvas -->
                <Border x:Name="CanvasCard" Grid.Row="0" Grid.Column="2"
                        Background="{DynamicResource Surface1Brush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        ClipToBounds="True">
                    <Grid>
                        <controls:DiscDesignCanvas x:Name="DesignCanvas" />
                        <!-- The tone module's file-region legend sits in the canvas corner:
                             it describes the blue zones without taking rail height. -->
                        <controls:VisibilityGate HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                 Margin="10,0,0,10"
                                                 IsOpen="{Binding Tone.HasFileRegionOverlay}">
                            <Border Padding="8,4"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusChip}">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="12" Height="12" Fill="#3385FF" RadiusX="2" RadiusY="2"
                                               Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource MicroText}" VerticalAlignment="Center"
                                               Text="{loc:Text Xaml.FileAreaIncludingFilesystem}" />
                                </StackPanel>
                            </Border>
                        </controls:VisibilityGate>
                        <!-- Always visible: the buttons are the discoverable way to zoom out,
                             so hiding the bar at fit zoom would hide the feature itself. -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,10,10" Padding="3"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusChip}"
                                ToolTip="{loc:Text Xaml.CtrlAltScrollToZoomMiddleDragToPan}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Click="ZoomOutClick"
                                        AutomationProperties.Name="{loc:Text Xaml.ZoomOut}" ToolTip="{loc:Text Xaml.ZoomOut}">
                                    <iconPacks:PackIconLucide Kind="Minus" Width="14" Height="14"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <TextBlock Text="{Binding ZoomPercent, ElementName=DesignCanvas}"
                                           Style="{StaticResource MicroText}" MinWidth="40"
                                           TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}" Click="ZoomInClick"
                                        AutomationProperties.Name="{loc:Text Xaml.ZoomIn}" ToolTip="{loc:Text Xaml.ZoomIn}">
                                    <iconPacks:PackIconLucide Kind="Plus" Width="14" Height="14"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                                <Border Width="1" Height="16" Margin="3,0" VerticalAlignment="Center"
                                        Background="{DynamicResource DividerBrush}" />
                                <Button Style="{StaticResource IconButton}" Click="ResetCanvasZoomClick"
                                        AutomationProperties.Name="{loc:Text Xaml.FitToWindow2}" ToolTip="{loc:Text Xaml.FitToWindowOrDoubleClickEmptySpace}">
                                    <iconPacks:PackIconLucide Kind="RefreshCcw" Width="14" Height="14"
                                                              Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right rail: selected-layer properties on top, the tone module below.
                     The rail is pinned to the viewport height (see UpdateResponsiveLayout),
                     so the tone card's star row absorbs the height the property card leaves
                     over and the column ends flush with the canvas. -->
                <ScrollViewer x:Name="RightRailScroll" Grid.Row="0" Grid.Column="4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              controls:ScrollMaskBehavior.Enabled="True">
                    <Grid x:Name="RightRail">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="PropsCard" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Xaml.Properties}" Style="{StaticResource PanelTitle}"
                                           Margin="0,0,0,12" />
                                <!-- Selected/empty as two gates, like every other page: the
                                     ContentPresenter keeps the numeric fields' implicit styles alive. -->
                                <controls:VisibilityGate IsOpen="{Binding HasSelection}">
                                    <ContentControl Content="{Binding SelectedLayer}" />
                                </controls:VisibilityGate>
                                <controls:VisibilityGate IsOpen="{Binding HasSelection}" Inverted="True">
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="{loc:Text Xaml.SelectALayerOnTheCanvasToEditIts}" />
                                </controls:VisibilityGate>
                            </StackPanel>
                        </Border>

                        <!-- Tone lives next to the composite because it is the last step of the
                             same material: the preview projects the composed picture through the
                             engines' mapping, and the sliders feed generation, burn and read-back
                             through the shared state. -->
                        <Border x:Name="ToneCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14"
                                Margin="0,16,0,0">
                            <controls:TonePanel x:Name="ToneRail" DataContext="{Binding Tone}" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
