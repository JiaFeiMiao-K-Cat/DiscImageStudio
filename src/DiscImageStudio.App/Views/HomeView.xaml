<UserControl x:Class="DiscImageStudio.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DiscImageStudio.Localization"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- The page padding lives on the content, not on the scroller, so the scroll rail sits at
         the window edge like every other workspace. -->
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <!-- MaxWidth alone centers this column: Stretch + MaxWidth arranges it at 1120 and
             WPF centers the capped element, so the sections span the full page column. -->
        <StackPanel MaxWidth="1120" Margin="{StaticResource PagePadding}">
            <!-- Hero band: the app's own icon and name on the blue gradient, with the two ways
                 into work — a new project or an existing one. -->
            <Border x:Name="Hero" Background="{DynamicResource HomeHeaderBrush}" Padding="28,24,28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource AppIconSource}" Width="64" Height="64" VerticalAlignment="Top"
                           Margin="0,2,20,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Disc Image Studio" Style="{StaticResource H1Title}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"
                                   Text="{loc:Text Xaml.CreateAndBurnVisibleArtworkOnOpticalDiscs}" />
                        <WrapPanel Margin="0,20,0,0">
                            <Button x:Name="NewProjectButton" Style="{StaticResource PrimaryButton}" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding NewProjectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Text Xaml.NewProject}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenProjectButton" Style="{StaticResource SecondaryButton}" Padding="16,0" Margin="0,0,8,6"
                                    Command="{Binding OpenProjectCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="{loc:Text Xaml.OpenProject}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="0,0,0,6"
                                    Command="{Binding ContinueProjectCommand}"
                                    Visibility="{Binding IsProjectOpenVisibility}"
                                    ToolTip="{loc:Text Xaml.ReturnToTheOpenProjectAndContinueInDesign}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center"
                                                              Foreground="{DynamicResource PrimaryBrush}" />
                                    <TextBlock Text="{loc:Text Xaml.BackToProject}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentProjectName}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{loc:Text Xaml.StartFromATemplate}" Style="{StaticResource CardTitle}"
                       FontSize="20" Margin="0,26,0,12" />
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Width="148" Height="Auto" MinHeight="124" Margin="0,0,8,8"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.TemplateCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                ToolTip="{Binding ToolTipText}">
                            <Grid>
                                <StackPanel>
                                    <Border Width="32" Height="32" HorizontalAlignment="Left"
                                            CornerRadius="{StaticResource RadiusField}"
                                            Background="{DynamicResource PrimarySoftBrush}">
                                        <iconPacks:PackIconLucide Kind="{Binding Icon}" Width="19" Height="19"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Foreground="{DynamicResource PrimaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource RowText}"
                                               FontWeight="SemiBold" MinHeight="36" MaxHeight="40" Margin="0,7,0,0"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CompactHint}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <iconPacks:PackIconLucide Kind="Sprout" Width="13" Height="13"
                                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                                          Margin="0,3,1,0"
                                                          Foreground="{DynamicResource PrimaryBrush}"
                                                          Visibility="{Binding ContributorVisibility}"
                                                          ToolTip="{Binding ContributorToolTip}"
                                                          ToolTipService.Placement="Bottom"
                                                          ToolTipService.InitialShowDelay="0"
                                                          ToolTipService.BetweenShowDelay="0" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No recents means no section: an empty "最近工程" heading is noise on first run. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecents}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,22,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Text Xaml.RecentProjects}" Style="{StaticResource CardTitle}" FontSize="20"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="{loc:Text Xaml.Clear}"
                            Height="{StaticResource CompactHeight}" Padding="14,0"
                            Command="{Binding ClearRecentsCommand}" />
                </Grid>
                <!-- Recent tiles use 1–3 columns according to their available width. The ContextMenu
                     reaches the view model through PlacementTarget.Tag, while its own
                     DataContext stays the tile. -->
                <ItemsControl x:Name="RecentProjects" ItemsSource="{Binding Recents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding RecentColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:RecentProjectCard Margin="4"
                                                        Tag="{Binding DataContext,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Title="{Binding Title}"
                                                        FamilyLabel="{Binding FamilyLabel}"
                                                        LocationText="{Binding LocationText}"
                                                        ThumbnailSource="{Binding Thumbnail}"
                                                        IsLoading="{Binding IsLoading}"
                                                        Command="{Binding DataContext.OpenRecentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding ToolTipText}">
                                <controls:RecentProjectCard.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{loc:Text Xaml.RemoveFromList}"
                                                  Command="{Binding PlacementTarget.Tag.RemoveRecentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="{loc:Text 删除工程}"
                                                  Command="{Binding PlacementTarget.Tag.DeleteRecentCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </controls:RecentProjectCard.ContextMenu>
                            </controls:RecentProjectCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
