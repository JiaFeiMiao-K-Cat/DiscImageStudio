<UserControl x:Class="DiscImageStudio.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <!-- The page padding lives on the content, not on the scroller, so the scroll rail sits at
         the window edge like every other workspace. -->
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <!-- MaxWidth alone centers this column: Stretch + MaxWidth arranges it at 1120 and
             WPF centers the capped element, so the sections span the full page column. -->
        <StackPanel MaxWidth="1120" Margin="{StaticResource PagePadding}">
            <TextBlock Text="Disc Image Studio" Style="{StaticResource H1Title}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                       Text="全能的光盘盘面可见图像生成与刻录工作台" />

            <!-- One card for the three ways forward: the open project on the left, starting
                 something else on the right. The project name appears once, on the control that
                 actually goes there. -->
            <Border Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                            Height="{StaticResource ControlHeight}" Padding="18,0"
                            Command="{Binding ContinueProjectCommand}"
                            Visibility="{Binding IsProjectOpenVisibility}"
                            ToolTip="回到打开的工程，从设计工作区继续。">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Kind="ArrowLeft" Width="16" Height="16"
                                                      VerticalAlignment="Center"
                                                      Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Text="返回工程" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentProjectName}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="打开工程"
                                Height="{StaticResource ControlHeight}" Padding="18,0"
                                Command="{Binding OpenProjectCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="新建工程"
                                Height="{StaticResource ControlHeight}" Padding="18,0" Margin="10,0,0,0"
                                Command="{Binding NewProjectCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sections follow the Adobe start-page idiom: a bare heading and the content
                 sitting directly on the page, no surrounding card. -->
            <TextBlock Text="从模板开始" Style="{StaticResource CardTitle}" Margin="0,32,0,8" />
            <!-- Tiles left-align with the section heading; a hanging last row is correct in
                 the flat, Adobe-style layout. -->
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TileButton}" Width="146" Height="132" Margin="4"
                                CommandParameter="{Binding}"
                                Command="{Binding DataContext.TemplateCommand,
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                ToolTip="{Binding ToolTipText}">
                            <StackPanel VerticalAlignment="Center">
                                <iconPacks:PackIconLucide Kind="{Binding Icon}" Width="30" Height="30"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource RowText}"
                                           FontWeight="Medium" Height="36" Margin="0,10,0,0" TextAlignment="Center"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CompactHint}"
                                           Height="20" Margin="0,4,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- No recents means no section: an empty "最近工程" heading is noise on first run. -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRecents}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,36,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="最近工程" Style="{StaticResource CardTitle}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="清空"
                            Height="{StaticResource CompactHeight}" Padding="14,0"
                            Command="{Binding ClearRecentsCommand}" />
                </Grid>
                <!-- Three mini tiles per row at any window width: UniformGrid stretches the
                     tiles, the sleeve's 3*:1* template shrinks with them. Tag carries the
                     remove command into the ContextMenu, which sits in a popup outside the
                     visual tree: the menu item reaches it via PlacementTarget, and its own
                     DataContext stays the tile. -->
                <ItemsControl ItemsSource="{Binding Recents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:RecentProjectCard Margin="4"
                                                        Tag="{Binding DataContext.RemoveRecentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Title="{Binding Title}"
                                                        FamilyLabel="{Binding FamilyLabel}"
                                                        LocationText="{Binding LocationText}"
                                                        ThumbnailSource="{Binding Thumbnail}"
                                                        Command="{Binding DataContext.OpenRecentCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding ToolTipText}">
                                <controls:RecentProjectCard.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="从列表中移除"
                                                  Command="{Binding PlacementTarget.Tag,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </controls:RecentProjectCard.ContextMenu>
                            </controls:RecentProjectCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
