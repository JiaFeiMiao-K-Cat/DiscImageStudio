<UserControl x:Class="DiscImageStudio.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels">
    <ScrollViewer controls:ScrollMaskBehavior.Enabled="True">
        <StackPanel Margin="{StaticResource PagePadding}">
            <controls:PageHeader Title="导出" Badge="{Binding FamilyLabel}"
                                 Workspace="{x:Static vm:Workspace.Export}"
                                 Hint="导出设计页的合成图为可刻录的镜像。相关参数请在“工程设置”中修改">
                <controls:PageHeader.Actions>
                    <Button Style="{StaticResource CompactButton}" Content="下一步：刻录"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="{x:Static vm:Workspace.Burn}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- Source: the composite the design page renders. Export always writes the
                 project composite as-is, so this card applies unconditionally (the burn
                 workspace is where a different material can be picked). -->
            <controls:SectionCard Header="源图片" IconKind="Image" Margin="0,0,0,24">
                <StackPanel>
                    <!-- The generation geometry is edited in the project settings, so the source
                         row carries the jump to its owner. -->
                    <controls:SourceChip Text="{Binding SourceSummary}">
                        <controls:SourceChip.Actions>
                            <Button Style="{StaticResource CompactButton}" Content="工程设置…"
                                    Command="{Binding OpenProjectSettingsCommand}"
                                    ToolTip="几何参数（半径、扇区、轨距）在工程设置中修改。" />
                        </controls:SourceChip.Actions>
                    </controls:SourceChip>
                    <!-- Empty source: the sentence above says what is missing; this says where
                         to fix it. Once layers exist the jump goes away with the gap. -->
                    <controls:VisibilityGate IsOpen="{Binding HasLayers}" Inverted="True">
                        <Button Style="{StaticResource CompactButton}" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Content="前往设计导入图片"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="{x:Static vm:Workspace.Design}" />
                    </controls:VisibilityGate>
                </StackPanel>
            </controls:SectionCard>

            <!-- Tone moved to the design page, next to the composite it maps. This page only
                 carries the byte-level output choices. -->
            <controls:SectionCard Header="输出文件" IconKind="Folder">
                <StackPanel>
                    <controls:VisibilityGate IsOpen="{Binding IsCd}">
                        <StackPanel>
                            <controls:PathField Label="输出音轨 (.wav / .raw)"
                                                Text="{Binding State.CdOutputPath}"
                                                ButtonLabel="选择…"
                                                Hint="推荐以 WAV 格式导出。"
                                                Command="{Binding BrowseOutputCommand}" />
                            <!-- CD-DA encoding is the one option that changes the bytes rather
                                 than the file container, so it gets its own labelled row above
                                 the format-specific ones instead of trailing the card. -->
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,2"
                                       Text="CD-DA 编码" />
                            <controls:InterleaveToggle IsChecked="{Binding State.CdInterleave}"
                                                       Hint="生成音轨时按 CD-DA 标准做延迟交织。不清楚请默认勾选此项。"
                                                       AutomationProperties.Name="启用 CD-DA 延迟交织" />
                            <!-- CUE sheets only make sense next to PCM WAV output, so the option
                                 follows the chosen output format instead of sitting permanently. -->
                            <controls:VisibilityGate IsOpen="{Binding State.IsCdWaveOutput}" Margin="0,12,0,0">
                                <CheckBox Content="同时导出 CUE 文件" IsChecked="{Binding State.CdWriteCue}" />
                            </controls:VisibilityGate>
                        </StackPanel>
                    </controls:VisibilityGate>

                    <controls:VisibilityGate IsOpen="{Binding IsDvd}">
                        <StackPanel>
                            <controls:PathField Label="输出 ISO"
                                                Text="{Binding State.DvdOutputPath}"
                                                ButtonLabel="选择…"
                                                Command="{Binding BrowseOutputCommand}"
                                                Margin="0,0,0,14" />
                            <controls:PathField Label="可选：随盘保存的文件夹（留空则整盘只绘图）"
                                                Text="{Binding State.DvdDataDirectory}"
                                                ButtonLabel="选择…"
                                                Command="{Binding BrowseDataCommand}" />
                            <controls:VisibilityGate IsOpen="{Binding State.HasDvdFiles}">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="文件位置" Margin="0,0,0,6" />
                                    <controls:SegmentedControl LabelA="内圈" LabelB="外圈"
                                                               IsSecondSelected="{Binding State.DvdFilesAtOuterRing}" />
                                </StackPanel>
                            </controls:VisibilityGate>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="卷标" />
                            <TextBox Text="{Binding State.DvdVolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </StackPanel>
                    </controls:VisibilityGate>

                    <controls:VisibilityGate IsOpen="{Binding IsBluRay}">
                        <StackPanel>
                            <controls:PathField Label="输出 ISO"
                                                Text="{Binding State.BdOutputPath}"
                                                ButtonLabel="选择…"
                                                Command="{Binding BrowseOutputCommand}"
                                                Margin="0,0,0,14" />
                            <controls:PathField Label="可选：随盘保存的文件夹（留空则整盘只绘图）"
                                                Text="{Binding State.BdDataDirectory}"
                                                ButtonLabel="选择…"
                                                Command="{Binding BrowseDataCommand}" />
                            <controls:VisibilityGate IsOpen="{Binding State.HasBluRayFiles}">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="文件位置" Margin="0,0,0,6" />
                                    <controls:SegmentedControl LabelA="内圈" LabelB="外圈"
                                                               IsSecondSelected="{Binding State.BdFilesAtOuterRing}" />
                                </StackPanel>
                            </controls:VisibilityGate>
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,14,0,6" Text="卷标" />
                            <TextBox Text="{Binding State.BdVolumeLabel, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" />
                        </StackPanel>
                    </controls:VisibilityGate>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding GenerateButtonText}"
                                Command="{Binding GenerateCommand}" />
                        <TextBlock Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Text="写入文件不会改动盘片。" />
                    </StackPanel>
                </StackPanel>
            </controls:SectionCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
