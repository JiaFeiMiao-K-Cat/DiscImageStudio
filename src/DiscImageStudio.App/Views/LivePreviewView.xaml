<UserControl x:Class="DiscImageStudio.Views.LivePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DiscImageStudio.Controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:vm="clr-namespace:DiscImageStudio.ViewModels">
    <!-- Inspector (left) + monitor (right). The inspector is one set of rows projected over
         the project's disc family (see PreviewInspectorViewModel); the family itself follows
         the open project and offers no switch of its own — checking another project's
         artifact happens by opening that project. The mode switch above the panel (design
         projection vs finished-artifact read-back) is the page's own progressive disclosure,
         and the expert-only rows (measured geometry, preview precision) live collapsed
         inside the advanced expander. -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="预览" Badge="{Binding DiscFamilyLabel}"
                             Workspace="{x:Static vm:Workspace.Preview}"
                             Hint="“设计投影”按工程参数将源图投到盘面上，速度快；“成品读回”则读取已生成的镜像文件还原。生成几何参数请在工程设置中修改。">
            <controls:PageHeader.Actions>
                <Button Style="{StaticResource CompactButton}" Content="下一步：导出"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static vm:Workspace.Export}" />
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource SidePanelWidth}" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Three rows, not a stack: the panel card has to take the remaining viewport
                 height so its footer stays pinned. A StackPanel measures children with
                 unlimited height and would push the footer past the clipped page area. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <!-- The input switch governs the parameter panel below it. -->
                    <controls:SegmentedControl HorizontalAlignment="Stretch"
                                               LabelA="设计投影" LabelB="成品读回"
                                               IsSecondSelected="{Binding IsReadbackPreview}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      controls:ScrollMaskBehavior.Enabled="True">
                            <StackPanel Margin="18,18,18,12">

                                <!-- Design projection: the source is the design page's composite. -->
                                <controls:VisibilityGate IsOpen="{Binding IsCalibrationPreview}">
                                    <StackPanel>
                                        <TextBlock Text="源图片" Style="{StaticResource PanelTitle}"
                                                   Margin="0,0,0,10" />
                                        <controls:SourceChip Margin="0,0,0,12" />
                                        <controls:GeometrySummary Title="当前工程参数"
                                            EditCommand="{Binding EditGeometryCommand}"
                                            Margin="0,0,0,16" />

                                        <!-- Expert rows: the projection works without them (the
                                             measured set falls back to the generated geometry), so
                                             they stay folded until someone is comparing. -->
                                        <Expander Header="实测参数与预览精度（高级）" IsExpanded="False">
                                            <StackPanel Margin="0,4,0,0">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="内半径 (mm)" />
                                                        <TextBox Style="{StaticResource CompactTextBox}"
                                                                 Text="{Binding Inspector.MeasuredInnerRadius, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="外半径 (mm)" />
                                                        <TextBox Style="{StaticResource CompactTextBox}"
                                                                 Text="{Binding Inspector.MeasuredOuterRadius, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </Grid>
                                                <!-- DVD adds the cubic pitch distribution to the measured set;
                                                     CD has no such degree of freedom and shows no row. -->
                                                <controls:VisibilityGate IsOpen="{Binding Inspector.IsDvd}">
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="10" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="相对一次项" />
                                                                <TextBox Style="{StaticResource CompactTextBox}"
                                                                         Text="{Binding Inspector.MeasuredPitchLinear, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="相对二次项" />
                                                                <TextBox Style="{StaticResource CompactTextBox}"
                                                                         Text="{Binding Inspector.MeasuredPitchQuadratic, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock Style="{StaticResource FieldLabel}" Text="相对三次项" />
                                                                <TextBox Style="{StaticResource CompactTextBox}"
                                                                         Text="{Binding Inspector.MeasuredPitchCubic, UpdateSourceTrigger=PropertyChanged}" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Inspector.MeasuredPitchSummary}"
                                                                   Style="{StaticResource HintText}" Margin="0,0,0,12" />
                                                    </StackPanel>
                                                </controls:VisibilityGate>

                                                <TextBlock Text="预览精度" Style="{StaticResource PanelTitle}" />
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Style="{StaticResource FieldLabel}" Text="导出尺寸 (px)" />
                                                        <TextBox Style="{StaticResource CompactTextBox}"
                                                                 Text="{Binding Inspector.PreviewSize, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                    <controls:VisibilityGate Grid.Column="2"
                                                        IsOpen="{Binding Inspector.HasSamplesPerSector}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource FieldLabel}" Text="每扇区采样" />
                                                            <TextBox Style="{StaticResource CompactTextBox}"
                                                                     Text="{Binding Inspector.SamplesPerSector, UpdateSourceTrigger=PropertyChanged}" />
                                                        </StackPanel>
                                                    </controls:VisibilityGate>
                                                </Grid>
                                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                                                           Text="尺寸越大投影越细，刷新越慢。" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </controls:VisibilityGate>

                                <!-- Read-back input: the generated artifact is the input. -->
                                <controls:VisibilityGate IsOpen="{Binding IsReadbackPreview}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Inspector.ArtifactLabel}"
                                                   Style="{StaticResource PanelTitle}"
                                                   Margin="0,0,0,10" />
                                        <controls:PathField Margin="0,0,0,12" Compact="True"
                                                            Text="{Binding Inspector.ArtifactPath}"
                                                            ButtonLabel="浏览…"
                                                            Hint="{Binding Inspector.ArtifactHint}"
                                                            Command="{Binding Inspector.BrowseArtifactCommand}" />
                                        <controls:GeometrySummary Title="当前工程参数"
                                            EditCommand="{Binding EditGeometryCommand}" />

                                        <!-- Generated tracks carry their interleave in the sidecar
                                             metadata and sync the switch themselves; an external
                                             track (another tool, an old build) has none, so the
                                             read-back needs the user to declare it here. -->
                                        <controls:VisibilityGate IsOpen="{Binding Inspector.IsCdAudioArtifact}">
                                            <controls:InterleaveToggle Label="逆交织"
                                                                       IsChecked="{Binding Inspector.State.CdInterleave}"
                                                                       Hint="若音轨生成时启用了延迟交织，则应勾选该选项。"
                                                                       Margin="0,12,0,0" />
                                        </controls:VisibilityGate>
                                    </StackPanel>
                                </controls:VisibilityGate>

                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" Style="{StaticResource CardFooterBandStyle}">
                            <Button Style="{StaticResource CompactButton}" Content="刷新预览"
                                    Command="{Binding RefreshCommand}" Margin="18,0"
                                    HorizontalAlignment="Stretch" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- The monitor: title + artifact path + actions in the header, image in the body,
                 status in the footer. Empty state carries the jump to the workspace that
                 produces the missing input. -->
            <controls:MonitorCard Grid.Column="2"
                                  Title="{Binding ResultPreviewTitle}"
                                  Subtitle="{Binding ResultPreviewPath}"
                                  StatusText="{Binding StatusText}">
                <controls:MonitorCard.Actions>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding DownloadPreviewCommand}"
                            AutomationProperties.Name="导出预览"
                            ToolTipService.InitialShowDelay="150"
                            ToolTip="导出当前预览图到输入来源所在文件夹">
                        <iconPacks:PackIconLucide Kind="Download" Width="16" Height="16" />
                    </Button>
                </controls:MonitorCard.Actions>
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image Source="{Binding ResultImage}" Margin="18" Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResultImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <controls:EmptyStateCard IconKind="Disc"
                                             Description="{Binding ResultPreviewPlaceholderText}"
                                             ActionLabel="{Binding EmptyStateActionLabel}"
                                             ActionCommand="{Binding NavigateCommand}"
                                             ActionCommandParameter="{Binding EmptyStateActionWorkspace}">
                        <controls:EmptyStateCard.Style>
                            <Style TargetType="controls:EmptyStateCard">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResultImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:EmptyStateCard.Style>
                    </controls:EmptyStateCard>
                    <controls:VisibilityGate Grid.Row="1" IsOpen="{Binding HasFileRegionOverlay}">
                        <StackPanel Orientation="Horizontal" Margin="18,0,18,14">
                            <Rectangle Width="12" Height="12" Fill="#FACC15" RadiusX="2" RadiusY="2" Margin="0,0,8,0" />
                            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="黄色：文件区（含文件系统）" />
                        </StackPanel>
                    </controls:VisibilityGate>
                </Grid>
            </controls:MonitorCard>
        </Grid>
    </Grid>
</UserControl>
