<app:TransitionWindow x:Class="DiscImageStudio.CdExtraWindow"
        xmlns:app="clr-namespace:DiscImageStudio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="CD Extra · Disc Image Studio" Icon="{StaticResource AppIconSource}"
        Width="960" Height="712" MinWidth="740" MinHeight="530"
        WindowStartupLocation="CenterOwner" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="CdExtraCard" TargetType="GroupBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ContentPresenter ContentSource="Header" Margin="0,0,0,16" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CdExtraCardIcon" TargetType="icons:PackIconLucide">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:TitleBar ProjectTitle="CD Extra" UseSystemWindowCommands="True" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,18,24,16" MaxWidth="1120">
                <TextBlock Text="CD Extra" Style="{StaticResource H1Title}" />
                <TextBlock Text="内圈播放音乐，外圈刻录图案。使用空白 CD-R。"
                           Style="{StaticResource PageSubtitle}" Margin="0,4,0,16" />

                <Grid x:Name="_editing">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Style="{StaticResource CdExtraCard}" VerticalAlignment="Top">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconLucide Kind="Music" Style="{StaticResource CdExtraCardIcon}" />
                                <TextBlock Text="音乐曲目" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Button x:Name="AddMusicButton" Style="{StaticResource CompactButton}"
                                    HorizontalAlignment="Left" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Plus" Width="14" Height="14"
                                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="添加音乐…" />
                                </StackPanel>
                            </Button>
                            <Border Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusChip}" Padding="5">
                                <Grid Height="162">
                                    <ListBox x:Name="_list" Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource RowListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="音乐曲目">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" ToolTip="{Binding}" Style="{StaticResource RowText}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="尚未添加曲目" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=_list}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="SortMusicButton" Content="按文件名排序" Style="{StaticResource CompactButton}"
                                        ToolTip="按文件名升序排列，数字按数值排序" IsEnabled="False" Margin="0,0,6,0" />
                                <Button x:Name="MoveUpButton" Content="上移" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                                <Button x:Name="MoveDownButton" Content="下移" Style="{StaticResource CompactButton}" Margin="0,0,6,0" />
                                <Button x:Name="RemoveMusicButton" Content="移除" Style="{StaticResource QuietButton}" Height="32" />
                            </WrapPanel>
                            <TextBlock Text="按列表顺序播放。支持 WAV、MP3、FLAC、M4A、AAC、WMA，取决于 Windows 解码器。"
                                       Style="{StaticResource CompactHint}" Margin="0,12,0,0" />
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,12" />
                            <CheckBox x:Name="CdTextCheck" Content="写入 CD-TEXT（专辑、曲名、艺术家）"
                                      Style="{StaticResource CompactCheckBox}" />
                            <StackPanel x:Name="CdTextFields" Margin="0,10,0,0" IsEnabled="{Binding IsChecked, ElementName=CdTextCheck}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="信息来源" Style="{StaticResource InlineText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton x:Name="SourceWindowChoice" GroupName="CdTextSource" IsChecked="True" FontSize="13"
                                                 Content="本窗口导入的音源" VerticalAlignment="Center" Margin="0,0,14,0"
                                                 ToolTip="取自上面音乐文件的标签，缺省时用文件名" />
                                    <RadioButton x:Name="SourceDesignChoice" GroupName="CdTextSource" FontSize="13"
                                                 Content="“设计”页的信息" VerticalAlignment="Center"
                                                 ToolTip="取自设计页 CD-TEXT 中同一文件的文字；设计页没有的曲目仍用文件标签" />
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="专辑名" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CdTextAlbumBox" MaxLength="160"
                                                 Text="{Binding AlbumTitle, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="专辑名">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlbumTitleIssue}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="ToolTip" Value="{Binding AlbumTitleIssue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="专辑艺术家" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <TextBox x:Name="CdTextPerformerBox" MaxLength="160"
                                                 Text="{Binding AlbumPerformer, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="专辑艺术家">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAlbumPerformerIssue}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="ToolTip" Value="{Binding AlbumPerformerIssue}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,10,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="#" Style="{StaticResource MicroText}" />
                                    <TextBlock Grid.Column="1" Text="曲名" Style="{StaticResource MicroText}" />
                                    <TextBlock Grid.Column="3" Text="艺术家" Style="{StaticResource MicroText}" />
                                    <TextBlock Grid.Column="4" Text="来源" Style="{StaticResource MicroText}" Margin="8,0,0,0" />
                                </Grid>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusChip}" Padding="6,6,6,0">
                                    <Grid>
                                        <ScrollViewer MaxHeight="232" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="CdTextTrackList" ItemsSource="{Binding Rows}"
                                                          AutomationProperties.Name="逐曲 CD-TEXT">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="80" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding NumberText}" Style="{StaticResource MicroText}"
                                                                       VerticalAlignment="Center" ToolTip="{Binding FileName}" />
                                                            <TextBox Grid.Column="1" MaxLength="160"
                                                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{Binding TitleToolTip}" AutomationProperties.Name="曲名">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasTitleIssue}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBox Grid.Column="3" MaxLength="160"
                                                                     Text="{Binding Performer, UpdateSourceTrigger=PropertyChanged}"
                                                                     AutomationProperties.Name="艺术家">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CompactTextBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasPerformerIssue}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                                                                                <Setter Property="ToolTip" Value="{Binding PerformerIssue}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock Grid.Column="4" Text="{Binding Origin}" Style="{StaticResource MicroText}"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Origin}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Text="添加音乐后逐曲列出" HorizontalAlignment="Center"
                                                   Margin="0,4,0,10" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasItems, ElementName=CdTextTrackList}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="LookupButton" Style="{StaticResource CompactButton}" Margin="0,0,6,4"
                                            ToolTip="用 MusicBrainz（或 Apple Music）查找官方的英文或罗马字专辑与曲目名称；每次搜索前都会询问">
                                        <StackPanel Orientation="Horizontal">
                                            <icons:PackIconLucide Kind="Globe" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="在线查找专辑信息…" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock x:Name="CdTextNotice" Style="{StaticResource CompactHint}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningTextBrush}" Margin="0,4,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="CdTextHint" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CompactHint}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="CdTextWarning" Text="{Binding WarningText}" Style="{StaticResource CompactHint}"
                                           Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource CompactHint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="这里的文字只用于本窗口的刻录包，不改动设计页。准备刻录包时写入 package.cdextra.json。" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Column="2">
                        <GroupBox Style="{StaticResource CdExtraCard}">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="FolderOpen" Style="{StaticResource CdExtraCardIcon}" />
                                    <TextBlock Text="刻录包" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                                <TextBlock x:Name="_summary" Style="{StaticResource CompactText}"
                                           Margin="0,0,0,10" />
                                <controls:CdTrackRangeDisc x:Name="PackageRangeDisc" Width="170" HorizontalAlignment="Center"
                                                           Margin="0,0,0,10" Visibility="Collapsed"
                                                           AutomationProperties.Name="音轨刻录范围" />
                                <WrapPanel>
                                    <Button x:Name="PreparePackageButton" Content="准备刻录包…"
                                            Style="{StaticResource CompactButton}" Margin="0,0,6,4" />
                                    <Button x:Name="OpenPackageButton" Content="打开刻录包…"
                                            Style="{StaticResource CompactButton}" Margin="0,0,0,4" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Style="{StaticResource CdExtraCard}" Margin="0,12,0,0">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <icons:PackIconLucide Kind="Flame" Style="{StaticResource CdExtraCardIcon}" />
                                    <TextBlock Text="刻录机和介质" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="RefreshDevicesButton"
                                            Content="刷新" Style="{StaticResource CompactButton}" Margin="6,0,0,0" />
                                    <ComboBox x:Name="_devices" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource CompactComboBox}" AutomationProperties.Name="刻录机" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="请求倍速" Style="{StaticResource InlineText}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="_speed" DisplayMemberPath="DisplayName"
                                              Style="{StaticResource CompactComboBox}" IsEnabled="False"
                                              MinWidth="104" AutomationProperties.Name="请求倍速" />
                                </StackPanel>
                                <TextBlock x:Name="_speedHint" Style="{StaticResource CompactHint}" Margin="0,8,0,0" />
                                <Button x:Name="ResumePictureButton" Content="图案断点续写 / 校验…"
                                        Style="{StaticResource CompactButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                <Button x:Name="CheckMediaButton" Content="检查空白盘（不刻录）"
                                        Style="{StaticResource CompactButton}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left" IsEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                Background="{DynamicResource CaptionSurfaceBrush}" Padding="24,12,24,14">
            <StackPanel>
                <controls:VisibilityGate x:Name="MilestoneGate" Margin="0,0,0,10">
                    <controls:BurnMilestoneStrip x:Name="MilestoneStrip" />
                </controls:VisibilityGate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="_status" Text="就绪" Style="{StaticResource CompactText}" />
                        <ProgressBar x:Name="_progress" Maximum="100" Style="{StaticResource CompactProgressBar}"
                                     Margin="0,6,0,0" AutomationProperties.Name="任务进度" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="HistoryButton" Content="历史日志…" Style="{StaticResource QuietButton}" />
                        <Button x:Name="_cancel" Content="取消任务" Style="{StaticResource CompactButton}"
                                IsEnabled="False" Margin="6,0" />
                        <Button x:Name="_burn" Content="刻录此包…" Style="{StaticResource CompactPrimaryButton}"
                                IsEnabled="False" />
                    </StackPanel>
                </Grid>
                <TextBox x:Name="_log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Height="102" Margin="0,10,0,0"
                         FontSize="12" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.Name="任务日志" />
            </StackPanel>
        </Border>
        <!-- Every confirmation in this window (CD-TEXT, burn, resume) uses the app's own card. -->
        <controls:ConfirmModal x:Name="CdTextConfirm" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="20" />
    </Grid>
</app:TransitionWindow>
