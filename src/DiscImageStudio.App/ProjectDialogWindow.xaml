<Window x:Class="DiscImageStudio.ProjectDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DiscImageStudio.Localization"
        xmlns:controls="clr-namespace:DiscImageStudio.Controls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="{loc:Text Xaml.NewProject}"
        Width="992" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="32" CornerRadius="0"
                      ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Adobe-style text tab: a flat label with a 2px baseline marking the open category.
             Items must stay focusable: a non-focusable ListBoxItem does not select on mouse
             click, which leaves every tab inert. -->
        <Style x:Key="TemplateTabItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="TabBand" Background="Transparent" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Padding="10,3" Margin="0,0,4,6">
                            <TextBlock x:Name="TabLabel" Text="{Binding}" Style="{StaticResource RowText}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBand" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="TabLabel" Property="Foreground"
                                        Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Template card: icon on top, name and geometry underneath, selected state as the
             brand outline. Fixed width so the WrapPanel reads as a grid. Focusable for the
             same reason as the tabs: otherwise a click never selects the card. -->
        <Style x:Key="TemplateCardItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="148" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- Right-click removal, same idiom as the recent-project tiles on the home page.
                 Only user presets ("自定") enable the menu: built-in presets live in the
                 embedded catalog and have no user file entry to remove. Tag carries the
                 command because the menu lives in a popup outside the visual tree; its item
                 reads both the command and the tile through PlacementTarget. -->
            <Setter Property="Tag"
                    Value="{Binding DataContext.DeletePresetCommand,
                                    RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenuService.IsEnabled" Value="{Binding IsUserPreset}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="{loc:Text Xaml.DeletePreset}"
                                  Command="{Binding PlacementTarget.Tag,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource RadiusField}" Padding="10,14"
                                Margin="0,0,10,10">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Surface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="Card" Property="Background"
                                        Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:TitleBar Grid.Row="0" ProjectTitle="{Binding DialogTitle}" />

        <Grid Grid.Row="1" Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- The template browser owns the window: a star column lets the card grid
                         grow with the window, the details pane stays a fixed 312px inspector. -->
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: presets. Create mode shows category tabs over the card grid (最近
                     lists recently confirmed presets, the other tabs one per family); project
                     settings keep the family fixed and list only that family's presets. -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" ItemsSource="{Binding TemplateCategories}"
                             SelectedIndex="{Binding TemplateCategoryIndex}"
                             Visibility="{Binding TemplateTabsVisibility}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             KeyboardNavigation.TabNavigation="Once"
                             ItemContainerStyle="{StaticResource TemplateTabItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6"
                                Visibility="{Binding EditModeVisibility}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.ChangePreset}" />
                        <TextBlock Style="{StaticResource CompactHint}" Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{loc:Text Xaml.SelectingAnotherPresetReplacesTheCurrentGeometryParametersAfter}" />
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding VisibleTemplates}"
                             SelectedItem="{Binding SelectedTemplate}"
                             Background="Transparent" BorderThickness="0" Padding="0,4,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             KeyboardNavigation.TabNavigation="Once"
                             ItemContainerStyle="{StaticResource TemplateCardItem}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,0,0,10" Height="30">
                                        <iconPacks:PackIconLucide Kind="{Binding IconKind}"
                                                                  Width="28" Height="28"
                                                                  HorizontalAlignment="Center"
                                                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <iconPacks:PackIconLucide Kind="Sprout" Width="13" Height="13"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                  Margin="0,-3,0,0"
                                                                  Foreground="{DynamicResource PrimaryBrush}"
                                                                  Visibility="{Binding ContributorVisibility}"
                                                                  ToolTip="{Binding ContributorToolTip}"
                                                                  ToolTipService.Placement="Bottom"
                                                                  ToolTipService.InitialShowDelay="0"
                                                                  ToolTipService.BetweenShowDelay="0" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Padding="4,1" CornerRadius="{StaticResource RadiusChip}"
                                                Background="{DynamicResource Surface3Brush}"
                                                Visibility="{Binding UserBadgeVisibility}">
                                            <TextBlock Text="{loc:Text Xaml.Custom}" Style="{StaticResource MicroText}" />
                                        </Border>
                                    </Grid>
                                    <!-- Preset names can outrun the card: the line scrolls
                                         while the card is hovered (the home page's recent-
                                         project marquee) and carries the full name as a
                                         tooltip whenever it is clipped. -->
                                    <controls:MarqueeText Text="{Binding Title}" FontWeight="Medium"
                                                          Margin="0,0,0,2"
                                                          IsActive="{Binding IsMouseOver,
                                                                     RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MicroText}"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{Binding EmptyCategoryHint}" Style="{StaticResource HintText}"
                               HorizontalAlignment="Center" Margin="0,24,0,0"
                               Visibility="{Binding EmptyCategoryVisibility}" />
                </Grid>

                <!-- Gutter between the preset column and the details pane. -->
                <Border Grid.Column="1" Width="24" />

                <!-- Right: preset details. The project name and save location belong here too —
                     the pane is the one place that defines what will be created. -->
                <Border Grid.Column="2" Width="312"
                        Style="{StaticResource CardStyle}" Padding="18">
                    <!-- Save location is pinned to the bottom of the pane: it names the file
                         the dialog will create, so it must stay visible while the geometry
                         fields scroll. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{loc:Text Xaml.PresetDetails}" Style="{StaticResource PanelTitle}"
                                           Margin="0,0,0,14" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.ProjectName}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="80" />
                                <WrapPanel Margin="0,16,0,0" VerticalAlignment="Top">
                                    <StackPanel Width="116" Margin="0,0,12,14">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.InnerR0Mm}" />
                                        <TextBox Text="{Binding InnerRadiusText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="116" Margin="0,0,12,14">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.OuterR1Mm}" />
                                        <TextBox Text="{Binding OuterRadiusText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="116" Margin="0,0,12,14">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.GeometryTotalSectors}" />
                                        <TextBox Text="{Binding SectorsText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="116" Margin="0,0,12,14">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.UsableSectors}" />
                                        <TextBox Text="{Binding UsableSectorsText, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="{loc:Text Xaml.UsableSectorsHint}" />
                                    </StackPanel>
                                    <StackPanel Width="124" Margin="0,0,16,14"
                                                Visibility="Visible">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.LinearTerm}" />
                                        <TextBox Text="{Binding PitchLinearText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="124" Margin="0,0,16,14"
                                                Visibility="Visible">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.QuadraticTerm}" />
                                        <TextBox Text="{Binding PitchQuadraticText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Width="124" Margin="0,0,0,14"
                                                Visibility="Visible">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Text Xaml.CubicTerm}" />
                                        <TextBox Text="{Binding PitchCubicText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CompactHint}"
                                               Margin="0,0,0,14" TextWrapping="Wrap"
                                               Visibility="{Binding IsBluRayFieldsVisibility}"
                                               Text="{loc:Text Xaml.SingleLayerBDRSectorsMustBeAMultiple}" />
                                </WrapPanel>
                                <StackPanel Margin="0,0,0,4"
                                            Visibility="{Binding EditModeVisibility}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="{loc:Text Xaml.DiscType}" Style="{StaticResource FieldLabel}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Padding="6,2" CornerRadius="{StaticResource RadiusChip}"
                                                Background="{DynamicResource Surface3Brush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FamilyBadge}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource CompactButton}"
                                                Content="{loc:Text Xaml.SaveParametersAsPreset}"
                                                Command="{Binding SaveAsPresetCommand}" />
                                        <TextBlock Text="{Binding SavedPresetMessage}"
                                                   Style="{StaticResource HintText}" VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,4"
                                           Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" />
                            </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,6" Text="{loc:Text Xaml.SaveLocation}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Content="{loc:Text Xaml.Browse}"
                                        Command="{Binding BrowseSavePathCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="{Binding SaveFileNameHint}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Shared size group: both actions take the wider label's width, so the pair reads
                 as one control instead of two differently sized buttons. -->
            <Grid Grid.Row="1" HorizontalAlignment="Right" Margin="0,16,0,0" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="DialogAction" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="{loc:Text Xaml.Cancel}"
                        Click="Cancel_Click" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmLabel}"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </Grid>

        <!-- Overwrite guard for switching presets inside project settings; covers the whole
             dialog and takes Escape while it is open. -->
        <controls:ConfirmModal x:Name="PresetSwitchConfirm" Grid.RowSpan="2" />
    </Grid>
</Window>
