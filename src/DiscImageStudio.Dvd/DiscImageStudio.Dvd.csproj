<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows')) Or '$(EnableWindowsTargeting)' == 'true'">net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DiscImageStudio.Core\DiscImageStudio.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\DvdImageSolver\DvdImageSolver.csproj">
      <!-- The Windows engine is hosted as a DLL. WPF's temporary cross-build must
           not try to publish that referenced executable for the Linux host. -->
      <GlobalPropertiesToRemove Condition="!$([MSBuild]::IsOSPlatform('Windows'))">RuntimeIdentifier;SelfContained;PublishSingleFile</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!-- Host the existing solver in the portable module. The standalone Windows
         executable keeps its original entry point and target framework. -->
    <Compile Include="../DvdImageSolver/**/*.cs"
             Exclude="../DvdImageSolver/bin/**;../DvdImageSolver/obj/**"
             LinkBase="Engine" />
    <ProjectReference Include="../DiscImageStudio.Iso/DiscImageStudio.Iso.csproj" />
    <ProjectReference Include="../DiscImageStudio.ImageIO/DiscImageStudio.ImageIO.csproj" />
  </ItemGroup>
</Project>
